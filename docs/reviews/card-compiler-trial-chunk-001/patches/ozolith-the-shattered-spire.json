              "kind": "controller",
              "who": "you"
            },
            {
              "kind": "anyOf",
              "of": [
                {
                  "kind": "type",
                  "value": "Artifact"
                },
                {
                  "kind": "type",
                  "value": "Creature"
                }
              ]
            }
          ]
        },
        "counter": "+1/+1",
        "multiplier": 1,
        "addition": 1
      }
    ]
  }
