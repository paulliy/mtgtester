{
  "name": "Herald of Ilharg",
  "oracleId": "80d1866f-b5a5-42c6-b81a-851a34ec0cd9",
  "source": "compiler@claude-haiku-5-5",
  "handledLines": [
    "Whenever you cast a creature spell, put two +1/+1 counters on this creature. If that spell has mana value 5 or greater, this creature deals damage equal to the number of counters on it to each opponent."
  ],
  "compose": "append",
  "def": {
    "triggers": [
      {
        "kind": "triggered",
        "trigger": {
          "when": "castsSpell",
          "caster": "you",
          "filter": {
            "kind": "type",
            "value": "Creature"
          }
        },
        "optional": false,
        "targets": [],
        "effects": [
          {
            "op": "putCountersEach",
            "selector": {
              "kind": "self"
            },
            "counter": "+1/+1",
            "count": 2
          },
          {
            "op": "conditionalEffect",
            "condition": {
              "kind": "compareValues",
              "left": {
                "kind": "spellManaValue"
              },
              "cmp": ">=",
              "right": {
                "kind": "const",
                "n": 5
              }
            },
            "then": [
              {
                "op": "eachOpponentDamage",
                "amount": {
                  "kind": "countersOnSelf",
                  "counter": "+1/+1"
                }
              }
            ],
            "else": []
          }
        ],
        "description": "Whenever you cast a creature spell, put two +1/+1 counters on this creature. If that spell has mana value 5 or greater, this creature deals damage equal to the number of counters on it to each opponent."
      }
    ]
  }
}
