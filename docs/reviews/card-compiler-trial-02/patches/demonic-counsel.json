              },
              "destinations": [
                {
                  "zone": "hand"
                }
              ],
              "reveal": true
            }
          ]
        },
        {
          "op": "shuffle"
        }
      ],
      "description": "If there are four or more card types among cards in your graveyard, instead search your library for any card, put it into your hand, then shuffle."
    }
  }
