            "left": {
              "kind": "cardTypesInYourGraveyard"
            },
            "cmp": ">=",
            "right": {
              "kind": "const",
              "n": 4
            }
          },
          "then": [
            {
              "op": "searchLibrary",
              "filter": {
                "kind": "allOf",
                "of": []
              },
              "destinations": [
                {
                  "zone": "hand"
                }
              ]
            }
          ],
          "else": [
            {
              "op": "searchLibrary",
              "filter": {
                "kind": "subtype",
