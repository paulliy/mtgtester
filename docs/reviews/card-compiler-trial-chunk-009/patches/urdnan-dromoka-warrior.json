{
  "name": "Urdnan, Dromoka Warrior",
  "oracleId": "adc1f850-9217-4a90-8e6a-02ed226ef8df",
  "source": "compiler@claude-haiku-5-5",
  "handledLines": [
    "Whenever you attack, target attacking creature with a +1/+1 counter on it gains first strike until end of turn. If that creature has two or more +1/+1 counters on it, it gains double strike until end of turn instead."
  ],
  "compose": "append",
  "def": {
    "triggers": [
      {
        "kind": "triggered",
        "trigger": {
          "when": "attackDeclared",
          "attacker": "you"
        },
        "optional": false,
        "targets": [
          {
            "kind": "creature",
            "filter": {
              "kind": "allOf",
              "of": [
                {
                  "kind": "combatRole",
                  "role": "attacking"
                },
                {
                  "kind": "hasCounter",
                  "counter": "+1/+1"
                }
              ]
            }
          }
        ],
        "effects": [
          {
            "op": "conditionalEffect",
            "condition": {
              "kind": "compareValues",
              "left": {
                "kind": "countersOnTarget",
                "target": 0,
                "counter": "+1/+1"
              },
              "cmp": ">=",
              "right": {
                "kind": "const",
                "n": 2
              }
            },
            "then": [
              {
                "op": "grantKeywordUntilEot",
                "target": 0,
                "keyword": "double strike"
              }
            ],
            "else": [
              {
                "op": "grantKeywordUntilEot",
                "target": 0,
                "keyword": "first strike"
              }
            ]
          }
        ],
        "description": "Whenever you attack, target attacking creature with a +1/+1 counter on it gains first strike until end of turn. If that creature has two or more +1/+1 counters on it, it gains double strike until end of turn instead."
      }
    ]
  }
}
