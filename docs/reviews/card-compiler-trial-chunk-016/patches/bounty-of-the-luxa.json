{
  "name": "Bounty of the Luxa",
  "oracleId": "e6b20c30-88c2-4cb0-a5e4-46f1df924a7c",
  "source": "compiler@claude-haiku-5-5",
  "handledLines": [
    "At the beginning of your first main phase, remove all flood counters from this enchantment. If no counters were removed this way, put a flood counter on this enchantment and draw a card. Otherwise, add {C}{G}{U}."
  ],
  "compose": "append",
  "def": {
    "triggers": [
      {
        "kind": "triggered",
        "trigger": {
          "when": "precombatMain",
          "player": "you"
        },
        "optional": false,
        "targets": [],
        "effects": [
          {
            "op": "conditionalEffect",
            "condition": {
              "kind": "sourceHasCounters",
              "counter": "flood",
              "cmp": "==",
              "n": 0
            },
            "then": [
              {
                "op": "putCountersEach",
                "selector": {
                  "kind": "self"
                },
                "counter": "flood",
                "count": 1
              },
              {
                "op": "draw",
                "count": {
                  "kind": "const",
                  "n": 1
                }
              }
            ],
            "else": [
              {
                "op": "removeCounters",
                "target": "source",
                "counter": "flood",
                "count": {
                  "kind": "countersOnSelf",
                  "counter": "flood"
                }
              },
              {
                "op": "addMana",
                "amount": {
                  "kind": "const",
                  "n": 3
                },
                "colors": [],
                "fixedSymbols": [
                  "C",
                  "G",
                  "U"
                ]
              }
            ]
          }
        ],
        "description": "At the beginning of your first main phase, remove all flood counters from this enchantment. If no counters were removed this way, put a flood counter on this enchantment and draw a card. Otherwise, add {C}{G}{U}."
      }
    ]
  }
}
