{
  "name": "Shelinda, Yevon Acolyte",
  "oracleId": "b06c9a4b-f309-45b3-ae5b-0ce3f067a5cb",
  "source": "compiler@claude-haiku-5-5",
  "handledLines": [
    "Whenever another creature you control enters, put a +1/+1 counter on that creature if its power is less than ~'s power. Otherwise, put a +1/+1 counter on ~."
  ],
  "compose": "append",
  "def": {
    "triggers": [
      {
        "kind": "triggered",
        "trigger": {
          "when": "enters",
          "subject": {
            "kind": "permanent",
            "selector": {
              "kind": "allOf",
              "of": [
                {
                  "kind": "other"
                },
                {
                  "kind": "controller",
                  "who": "you"
                },
                {
                  "kind": "type",
                  "value": "Creature"
                }
              ]
            }
          }
        },
        "optional": false,
        "targets": [],
        "effects": [
          {
            "op": "conditionalEffect",
            "condition": {
              "kind": "compareValues",
              "left": {
                "kind": "powerOfTriggerObject"
              },
              "cmp": "<=",
              "right": {
                "kind": "plus",
                "of": {
                  "kind": "powerOfSource"
                },
                "n": -1
              }
            },
            "then": [
              {
                "op": "putCounters",
                "target": "triggerObject",
                "counter": "+1/+1",
                "count": 1
              }
            ],
            "else": [
              {
                "op": "putCounters",
                "target": "source",
                "counter": "+1/+1",
                "count": 1
              }
            ]
          }
        ],
        "description": "Whenever another creature you control enters, put a +1/+1 counter on that creature if its power is less than Shelinda's power. Otherwise, put a +1/+1 counter on Shelinda."
      }
    ]
  }
}
