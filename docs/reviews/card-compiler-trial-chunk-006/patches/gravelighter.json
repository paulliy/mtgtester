        "trigger": {
          "when": "enters",
          "subject": {
            "kind": "self"
          }
        },
        "optional": false,
        "targets": [],
        "effects": [
          {
            "op": "conditionalEffect",
            "condition": {
              "kind": "compareValues",
              "left": {
                "kind": "creaturesDiedThisTurn"
              },
              "cmp": ">=",
              "right": {
                "kind": "const",
                "n": 1
              }
            },
            "then": [
              {
                "op": "draw",
                "count": {
                  "kind": "const",
                  "n": 1
                }
              }
            ],
            "else": [
              {
                "op": "sacrificeEachPlayer",
                "count": 1,
                "filter": "creature"
              }
            ]
          }
        ],
        "description": "When this creature enters, draw a card if a creature died this turn. Otherwise, each player sacrifices a creature of their choice."
      }
    ]
  }
}
