# Settings for the table server on a VM behind a Cloudflare Tunnel.
# Copy to /etc/mtg-table.env (owned by root, mode 600) and replace tables.example.com
# with your subdomain. The guide is docs/guides/deploy-oracle-cloud.md.

# Bind to loopback only: cloudflared on the same VM is the only thing that reaches the server.
TABLE_HOST=127.0.0.1
TABLE_PORT=3002

# cloudflared terminates TLS at Cloudflare and connects from 127.0.0.1. The server trusts only that
# peer, and takes the player's address from the rightmost X-Forwarded-For entry, which Cloudflare
# sets to the visitor's address.
TABLE_BEHIND_TLS_PROXY=1
TABLE_TRUSTED_PROXY=127.0.0.1

# Your subdomain, with https:// for the two origins and without it for the host.
TABLE_PUBLIC_ORIGIN=https://tables.example.com
TABLE_ALLOWED_ORIGINS=https://tables.example.com
TABLE_ALLOWED_HOSTS=tables.example.com

# Optional: a fixed host secret (24 to 128 letters, digits, - or _), so you can create tables
# from the website without reading the log after each restart. Unset, a new random one is
# printed at every start. Generate one with: openssl rand -base64 33 | tr '+/' '-_' | tr -d '='
# TABLE_HOST_SECRET=

# Optional. Defaults are shown.
# TABLE_MAX_TABLES=8
# TABLE_CLOCK=relaxed
# The database is /var/lib/mtgtester/tables.sqlite (set in mtg-table.service), the one place the
# service may write. Leave TABLE_DB_PATH unset.

# Optional: an LLM provider key, so a host can choose Claude for a table's bots (the host
# screen's "Bots play as" switch; the built-in bot stays the default). Built-in bots need none.
# See .env.example for the supported providers. TABLE_CLAUDE_BOTS=off hides the switch even
# with a key set.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# TABLE_CLAUDE_BOTS=auto
