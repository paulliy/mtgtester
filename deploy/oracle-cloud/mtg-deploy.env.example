# Settings for the deploy agent (deploy-agent.sh). Copy to /etc/mtg-deploy.env (root, mode 600).

# A healthchecks.io check's ping URL. The agent pings it after every run that finds the right
# release running, and its /fail URL after a rollback. Set the check's period to 10 minutes.
# HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# Optional. Defaults are shown.
# WAIT_MINUTES=60       # how long to wait for games in progress before switching anyway
# START_SECONDS=300     # how long a new release has to answer /health before a rollback
# KEEP_RELEASES=3
# KEEP_BACKUPS=10
