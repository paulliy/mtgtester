# systemd unit for the table server. deploy/oracle-cloud/setup.sh installs it. It runs the release
# that /opt/mtgtester-releases/current points at (the deploy agent, mtg-deploy.timer, switches it),
# as the `mtg` user with Bun installed for that user, and keeps the database in /var/lib/mtgtester.
# The guide is docs/guides/deploy-oracle-cloud.md.

[Unit]
Description=MTG Tester table server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mtg
Group=mtg
WorkingDirectory=/opt/mtgtester-releases/current
# The database lives outside the releases, so a switch or rollback keeps the tables' history.
# /etc/mtg-table.env may override it, but the service can write only under /var/lib/mtgtester.
Environment=TABLE_DB_PATH=/var/lib/mtgtester/tables.sqlite
EnvironmentFile=/etc/mtg-table.env
# The home directory is read-only to the service, so Bun's transpiler cache stays off.
Environment=BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ExecStart=/home/mtg/.bun/bin/bun run packages/server/src/cli/serve-table.ts
Restart=on-failure
RestartSec=5
# The server stops its sockets and closes the database on SIGTERM.
KillSignal=SIGTERM
TimeoutStopSec=20

# Hardening: the server writes only its database. Releases are root-owned and read-only to it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=mtgtester
StateDirectoryMode=0700
ReadWritePaths=/var/lib/mtgtester
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
# AF_NETLINK lets the server list network interfaces for its start banner.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=
UMask=0077
# Not MemoryDenyWriteExecute: Bun's JIT needs writable code pages.

# On a 1 GB VM, if memory runs out the kernel kills this service before sshd or cloudflared,
# and systemd restarts it. A hard MemoryMax would kill it while swap could still carry it, so
# MemoryHigh throttles it into reclaim instead, and MemorySwapMax stops it from thrashing the
# whole VM through swap.
OOMScoreAdjust=500
MemoryHigh=700M
MemorySwapMax=1500M

[Install]
WantedBy=multi-user.target
