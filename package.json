{
  "name": "mtg-commander-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --build && vue-tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:tests": "tsc -p packages/engine/tsconfig.test.json --noEmit && tsc -p packages/server/tsconfig.test.json --noEmit && tsc -p scripts/contracts/tsconfig.json --noEmit",
    "typecheck:clean": "tsc --build --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --build",
    "dev": "bun run scripts/dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "serve": "bun run packages/server/src/cli/serve.ts",
    "serve:table": "bun run packages/server/src/cli/serve-table.ts",
    "decks": "bun run packages/server/src/cli/import-decks.ts",
    "retag": "bun run packages/server/src/cli/retag.ts",
    "pool": "bun run packages/server/src/cli/pool.ts",
    "modelled-cards": "bun run packages/server/src/cli/modelled-cards.ts",
    "scryfall:update": "bun run scripts/update-scryfall-bank.ts",
    "play-decks": "bun run packages/server/src/cli/play-decks.ts",
    "combat-sweep": "bun run packages/server/src/cli/combat-sweep.ts",
    "diplomacy-sweep": "bun run packages/server/src/cli/diplomacy-sweep.ts",
    "ai-bench": "bun run packages/server/src/cli/ai-bench.ts",
    "agent-client": "bun run packages/server/src/cli/agent-client.ts",
    "coverage": "bun run packages/server/src/cli/coverage.ts",
    "staples": "bun run packages/server/src/cli/staple-coverage.ts",
    "coverage:rebaseline": "bun run packages/server/src/cli/rebaseline-coverage.ts",
    "coverage:snapshot": "bun run packages/server/src/cli/snapshot-coverage-decks.ts",
    "snapshot:oracle": "bun run packages/server/src/cli/snapshot-deck-oracle.ts",
    "test:implemented": "bun run scripts/test-implemented-cards.ts",
    "test:card-gate": "bun run audit:card-ir && bun run check:suite-integrity && bun run scripts/card-gate.ts",
    "snapshots:write": "bun run scripts/snapshot-interpret-defs.ts && bun run scripts/snapshot-override-defs.ts",
    "snapshots:check": "bun run scripts/snapshot-interpret-defs.ts --check && bun run scripts/snapshot-override-defs.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright test --config playwright.setup.config.ts",
    "test:e2e:table": "playwright test --config playwright.table.config.ts",
    "coverage:complete": "bun run coverage --complete && bun run staples --complete",
    "audit:card-ir": "bun run scripts/audit-card-ir.ts",
    "check:suite-integrity": "bun run scripts/check-suite-integrity.ts",
    "check:suite-collect": "bun run scripts/check-suite-collect.ts",
    "check:manifest-tests": "bun run scripts/check-manifest-tests.ts",
    "mutate-cards": "bun run scripts/mutate-cards.ts",
    "pin-store": "bun run scripts/pin-store.ts",
    "card:check": "bun run scripts/cards/card-check.ts",
    "card:new": "bun run scripts/cards/card-new.ts",
    "card:finish": "bun run scripts/cards/card-finish.ts",
    "check:ratchets": "bun run scripts/check-ratchets.ts",
    "card-slugs:generate": "bun run scripts/generate-card-name-slugs.ts",
    "card-capabilities": "bun run scripts/card-capability-impact.ts",
    "test:primitive-contracts": "bun run scripts/test-primitive-contracts.ts",
    "primitive-promotions": "bun run scripts/check-primitive-promotions.ts",
    "test:pr09-verification": "bun run scripts/run-pr09-verification.ts",
    "test:pr08-verification": "bun run scripts/run-pr08-verification.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.3.11"
  }
}
