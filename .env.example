# ==============================================================================
# MTG Commander AI Simulator — Environment Configuration (.env)
# Copy this file to `.env` in the project root. `.env` is gitignored.
#
# You only need ONE provider's API key. The provider is auto-detected from whichever
# key is present (OpenRouter first), and its endpoint + model chain come with it — see
# `packages/server/src/ai/config.ts` and docs/decisions/0011-openai-compatible-provider.md.
# Set AI_PROVIDER explicitly if you have several keys and want to force one.
# ==============================================================================

# ------------------------------------------------------------------------------
# Provider Option 1: OpenRouter — the DEFAULT provider.
# API key: https://openrouter.ai/keys
#
# Default fallback model chain:
#   1. deepseek/deepseek-v4-flash
#   2. google/gemma-4-26b-a4b-it
#   3. google/gemma-4-31b-it
#   4. meta-llama/llama-3.3-70b-instruct
#   5. deepseek/deepseek-chat
#   6. google/gemini-2.5-flash-lite
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# Provider Option 2: Groq — https://console.groq.com/keys
# ------------------------------------------------------------------------------
# GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# Provider Option 2: Google Gemini (OpenAI-compatible endpoint)
# API key: https://aistudio.google.com/apikey
#
# WARNING: the free tier is 500 requests/day/model — LESS THAN ONE GAME. Usable for
# smoke tests, not a full run. Note also that `gemini-2.5-flash-lite` appears in
# GET /models but 404s with "no longer available to new users", so it is not in the chain.
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# ------------------------------------------------------------------------------
# Provider Option 3: DeepSeek — https://platform.deepseek.com/api_keys
# ------------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# ------------------------------------------------------------------------------
# Provider Option 4: OpenAI
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-proj-your_openai_key_here

# ------------------------------------------------------------------------------
# Overrides (optional). Vendor-neutral AI_* wins over everything, so any other
# OpenAI-compatible endpoint works without a preset.
# ------------------------------------------------------------------------------
# AI_PROVIDER=groq                  # force a vendor when several keys are set
# AI_BASE_URL=https://...           # arbitrary OpenAI-compatible endpoint
# AI_API_KEY=...
# AI_MODELS=model-a,model-b         # ordered fallback chain
# AI_RPM_LIMIT=30
# AI_MAX_RETRIES=6
# AI_HEURISTICS_ENABLED=1           # local answers for dominated decisions (ADR 0010)
# AI_DECISION_CACHE_ENABLED=1
# AI_MAX_OUTPUT_TOKENS=1000         # token budget for the decision JSON itself
# AI_STREAM_RESPONSES=1             # stream OpenRouter calls so a timeout stops billing (ADR 0040)
# AI_RETRY_ON_TIMEOUT=0             # a timed-out call falls back to the bot instead of a paid retry

# Bot-led tactics (ADR 0039): the card-aware heuristic bot answers tactical decisions and the
# strategist only sets its knobs, so model calls drop to about one per few turns per seat.
# AI_TACTICAL_MODE=bot              # bot (default) | model
# Escalation triggers (ADR 0044), comma-separated; an unknown name stops the server at start-up.
#   uncertain      the bot's top two options are within AI_BOT_ESCALATION_MARGIN LEP
#   scarce-answer  the bot would cast its last counterspell, wipe or hard removal, no lethal at stake
#   unknown-card   a noncreature, nonland spell it would use or must answer is one the IR classifier
#                  cannot account for
#   lethal         shadow only: public lethal and the bot's line neither takes nor prevents it
# AI_BOT_ESCALATION=never           # never (default) | a list of the live triggers above
# AI_BOT_ESCALATION_SHADOW=         # triggers to log only (engine debug log, call census)
# AI_BOT_ESCALATION_MARGIN=1        # LEP margin under which a close call escalates
# AI_STRATEGIST_REPLAN=onChange     # onChange (default) | everyTurn, bot mode only
# AI_STRATEGIST_MAX_REUSE_TURNS=3   # most own turns knobs are reused before asking again
# AI_STRATEGIST_TACTICIAN_FLAG=off  # off (default) | shadow: the bot-led strategist may ask for the
#                                   # tactician on a turn; logged for ADR 0045's study, never acted on

# Reasoning is OFF by default: a decision is a menu pick, and thinking tokens are billed.
# Turning it on adds headroom to AI_MAX_OUTPUT_TOKENS, because a provider's max_tokens caps
# thinking and answer together (ADR 0015).
# AI_REASONING_ENABLED=1
# AI_REASONING_EFFORT=low           # none | low | medium | high | max ('max' is sent as 'high')

# Two-tier decision profiles. OpenRouter defaults shown below; every value is overrideable.
# The strategist thinks once per active turn. Tacticians apply that plan to legal menus.
# AI_STRATEGIST_ENABLED=1
# AI_STRATEGIST_MODELS=z-ai/glm-5.3-flash,deepseek/deepseek-v4-flash
# AI_STRATEGIST_REASONING_ENABLED=1
# AI_STRATEGIST_REASONING_EFFORT=low
# AI_STRATEGIST_MAX_OUTPUT_TOKENS=1000
# AI_STRATEGIST_REASONING_TOKEN_HEADROOM=4000
# AI_STRATEGIST_REQUEST_TIMEOUT_MS=45000
# AI_STRATEGIST_MAX_RETRIES=2
# AI_STRATEGIST_PREFERRED_MAX_LATENCY_SECONDS=30
# AI_STRATEGIST_PREFERRED_MIN_THROUGHPUT=100
# AI_TACTICIAN_MODELS=particle-ai/particle-1,deepseek/deepseek-v4-flash
# AI_TACTICIAN_REASONING_ENABLED=1
# AI_TACTICIAN_REASONING_EFFORT=low
# AI_TACTICIAN_REQUEST_TIMEOUT_MS=10000
# AI_TACTICIAN_MAX_RETRIES=1
# AI_TACTICIAN_PREFERRED_MAX_LATENCY_SECONDS=10
# AI_TACTICIAN_PREFERRED_MIN_THROUGHPUT=10
# AI_TACTICIAN_IGNORE_PROVIDERS=CoreWeave,Modal,Cohere   # OpenRouter provider names never routed to
# AI_TACTICIAN_MAX_OUTPUT_TOKENS=256
# AI_TACTICIAN_REASONING_TOKEN_HEADROOM=1024
# AI_STRATEGY_RECENT_DECISIONS=8
# AI_COMBAT_ROLLOUTS_ENABLED=0       # reserved for the post-strategist rollout experiment

# Jev typed action selector. Both rollout modes are OFF by default. Shadow mode records evidence
# but cannot change the chat tactician's answer. Authoritative mode refuses to start until both
# calibrated thresholds are explicit. OPENROUTER_API_KEY is reused unless AI_JEV_API_KEY is set.
# AI_JEV_API_KEY=sk-or-v1-dedicated_key
# AI_JEV_SHADOW_ENABLED=0
# AI_JEV_ENABLED=0
# AI_JEV_MODEL=typesafe/jev-1.13
# AI_JEV_REQUEST_TIMEOUT_MS=2000
# AI_JEV_MAX_ACTIONS=255
# AI_JEV_MIN_CONFIDENCE=0.80
# AI_JEV_MIN_TOP_TWO_MARGIN=0.15
# Where Jev sits (ADR 0041). With AI_TACTICAL_MODE=bot and AI_BOT_ESCALATION=uncertain, active Jev
# answers the bot's close calls; scarce-answer and unknown-card escalations skip Jev (ADR 0044). AI_JEV_FALLBACK=bot keeps the bot's answer when Jev cannot decide,
# instead of asking the chat tactician. Shadow scope "uncertain" asks Jev only on bot close calls.
# AI_JEV_FALLBACK=model             # model | bot
# AI_JEV_SHADOW_SCOPE=all           # all | uncertain
# AI_JEV_CLOSE_CALL_MENU=top2       # top2: Jev picks between the bot's best two, answer always used | full
# AI_JEV_EXPAND_TARGETS=1           # offer a targeted action once per legal target

# Archetype inference (ADR 0022). A deterministic classifier always runs at import and costs
# nothing; this flag adds one small model call per deck to polish its wording. Off by default,
# and on any failure the computed tag stands — importing never depends on it.
# AI_ARCHETYPE_INFERENCE=1
# AI_ARCHETYPE_MODELS=qwen/qwen3.7-flash,deepseek/deepseek-v4-flash
# AI_ARCHETYPE_REQUEST_TIMEOUT_MS=8000

# Post-game AI commentary (ADR 0022 §7). One call per AI seat, made only after the game has
# already ended — it never delays the result. Off by default.
#
# The new-game screen has its own "Post-game commentary" checkbox, and a game started from there
# sends an explicit choice that overrides this. Setting this to 1 is for the paths that don't ask
# (CLIs, tests); leaving it unset means the checkbox alone decides.
# AI_REFLECTION_ENABLED=1
# AI_REFLECTION_MODELS=deepseek/deepseek-v4-flash,tencent/hy3
# AI_REFLECTION_MAX_OUTPUT_TOKENS=700
# AI_REFLECTION_REQUEST_TIMEOUT_MS=30000
