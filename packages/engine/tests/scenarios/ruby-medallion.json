      "expectedOutcome": "Scenario Elk is not castable and stays in your hand.",
      "seats": {
        "P1": {
          "hand": ["Scenario Elk"],
          "battlefield": ["Ruby Medallion", "Forest"]
        }
      },
      "script": [],
      "expect": [
