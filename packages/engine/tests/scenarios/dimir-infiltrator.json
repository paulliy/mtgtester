{
  "schemaVersion": 1,
  "card": "Dimir Infiltrator",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Cub",
      "typeLine": "Creature — Bear",
      "manaCost": "{2}{G}",
      "power": "3",
      "toughness": "3"
    }
  ],
  "scenarios": [
    {
      "id": "dimir-infiltrator-transmute",
      "title": "Dimir Infiltrator: transmute finds a card with the same mana value (2)",
      "clauses": [2],
      "instructions": [
        "Activate transmute from your hand, paying with your lands.",
        "Search your library and take Scenario Bear."
      ],
      "expectedOutcome": "Dimir Infiltrator is discarded, Scenario Bear is revealed and put into your hand, Scenario Cub (mana value 3) stays in the library, and the library is shuffled.",
      "seats": {
        "P1": {
          "hand": ["Dimir Infiltrator"],
          "battlefield": ["Island", "Island", "Swamp"],
          "libraryTop": ["Scenario Cub", "Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Dimir Infiltrator \\(hand\\): Transmute/"
        },
        {
          "player": "P1",
          "choose": "/Scenario Bear/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Scenario Bear"],
            "lacks": ["Dimir Infiltrator"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Dimir Infiltrator"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "library",
            "has": ["Scenario Cub"],
            "lacks": ["Scenario Bear"]
          }
        },
        {
          "event": {
            "type": "shuffle",
            "count": 1
          }
        },
        {
          "event": {
            "type": "searchFound",
            "payload": "\"revealed\":true",
            "count": 1
          }
        }
      ]
    },
    {
      "id": "dimir-infiltrator-transmute-no-match",
      "title": "Dimir Infiltrator: transmute offers nothing of another mana value",
      "clauses": [2],
      "instructions": ["Activate transmute with only a mana value 3 card in your library."],
      "expectedOutcome": "Dimir Infiltrator is still discarded, Scenario Cub is not offered and stays in the library, and the library is shuffled.",
      "seats": {
        "P1": {
          "hand": ["Dimir Infiltrator"],
          "battlefield": ["Island", "Island", "Swamp"],
          "libraryTop": ["Scenario Cub"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Dimir Infiltrator \\(hand\\): Transmute/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "lacks": ["Scenario Cub", "Dimir Infiltrator"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Dimir Infiltrator"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "library",
            "has": ["Scenario Cub"]
          }
        },
        {
          "event": {
            "type": "shuffle",
            "count": 1
          }
        }
      ]
    }
  ]
}
