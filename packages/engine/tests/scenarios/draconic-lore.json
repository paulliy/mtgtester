          "choose": "/^Cast Draconic Lore/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Scenario Ant", "Scenario Bee", "Scenario Cat"]
          }
        },
