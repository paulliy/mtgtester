          }
        }
      ]
    },
    {
      "id": "draconic-lore-opponents-dragon-no-discount",
      "title": "Draconic Lore: a Dragon an opponent controls gives no discount",
      "clauses": [1],
      "instructions": [
        "P1 controls Scenario Bear and four Islands while P2 controls Scenario Dragon; try to cast Draconic Lore."
      ],
      "expectedOutcome": "Draconic Lore is not castable for four mana and stays in P1's hand.",
