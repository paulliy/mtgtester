  "scenarios": [
    {
      "id": "inkwell-leviathan-unblockable-with-island",
      "title": "Inkwell Leviathan: can't be blocked while the defender controls a Island",
      "clauses": [2],
      "instructions": [
        "Attack P2 with Inkwell Leviathan while P2 controls a Island and Scenario Bear."
      ],
      "expectedOutcome": "P2 is never asked to block; Inkwell Leviathan deals 7 damage to P2.",
      "seats": {
        "P1": {
          "battlefield": ["Inkwell Leviathan"]
        },
        "P2": {
          "battlefield": ["Island", "Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 33
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "inkwell-leviathan-blockable-without-island",
      "title": "Inkwell Leviathan: may be blocked when the defender controls no Island",
      "clauses": [2],
      "instructions": [
        "Attack P2 with Inkwell Leviathan while P2 controls only Scenario Bear and a Plains.",
        "P2 blocks with Scenario Bear."
      ],
      "expectedOutcome": "The block is legal: Inkwell Leviathan is blocked by Scenario Bear and P2 takes no combat damage from it.",
      "seats": {
        "P1": {
          "battlefield": ["Inkwell Leviathan"]
        },
        "P2": {
          "battlefield": ["Plains", "Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Inkwell Leviathan"]
        },
        {
          "player": "P1",
          "choose": "All 7 damage to Scenario Bear"
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bear"]
          }
        }
      ]
    }
  ]
