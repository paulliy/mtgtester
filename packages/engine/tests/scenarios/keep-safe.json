          "targets": ["P1"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P1",
            "equals": 37
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
