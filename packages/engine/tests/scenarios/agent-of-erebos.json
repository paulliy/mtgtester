{
  "schemaVersion": 1,
  "card": "Agent of Erebos",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Aura Ward",
      "typeLine": "Enchantment",
      "manaCost": "{1}{B}"
    }
  ],
  "scenarios": [
    {
      "id": "agent-of-erebos-exiles-target-graveyard",
      "title": "Agent of Erebos: its constellation trigger exiles the target player's graveyard",
      "clauses": [1],
      "instructions": [
        "Cast Agent of Erebos; when it enters, target P2 with the constellation trigger."
      ],
      "expectedOutcome": "P2's graveyard is exiled: Scenario Bear is in P2's exile, not their graveyard.",
      "seats": {
        "P1": {
          "hand": ["Agent of Erebos"],
          "battlefield": ["Swamp", "Swamp", "Swamp", "Swamp"]
        },
        "P2": {
          "graveyard": ["Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Agent of Erebos/"
        },
        {
          "player": "P1",
          "choose": "/^Targets for Agent of Erebos/",
          "targets": ["P2"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "exile",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "lacks": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "agent-of-erebos-nonenchantment-does-not-trigger",
      "title": "Agent of Erebos: a creature that is not an enchantment entering does not trigger it",
      "clauses": [1],
      "instructions": ["With Agent of Erebos on the battlefield, cast Scenario Bear."],
      "expectedOutcome": "Scenario Bear is not an enchantment, so nothing is exiled: P2's graveyard still holds Scenario Bear.",
      "seats": {
        "P1": {
          "hand": ["Scenario Bear"],
          "battlefield": ["Agent of Erebos", "Forest", "Forest"]
        },
        "P2": {
          "graveyard": ["Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Scenario Bear/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bear"]
          }
        }
      ]
    }
  ]
}
