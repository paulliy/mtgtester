      "title": "The Ozolith: a creature you control dies with counters, and The Ozolith gets them",
      "clauses": [1],
      "instructions": [
        "Cast Scenario Snuff on your Scenario Bear, which has two +1/+1 counters and a flying counter."
      ],
      "expectedOutcome": "Scenario Bear dies and The Ozolith gets two +1/+1 counters and a flying counter.",
      "seats": {
        "P1": {
          "hand": ["Scenario Snuff"],
          "battlefield": [
            "The Ozolith",
            "Swamp",
            {
              "card": "Scenario Bear",
              "counters": {
                "+1/+1": 2,
                "flying": 1
              }
            }
          ]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Scenario Snuff/",
          "targets": ["Scenario Bear"]
        }
      ],
      "expect": [
        {
          "zone": {
