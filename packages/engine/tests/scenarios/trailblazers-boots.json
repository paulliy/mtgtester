                "card": "Scenario Bear"
              }
            }
          ]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Scenario Cave"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
