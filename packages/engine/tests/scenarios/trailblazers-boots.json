            "zone": "battlefield",
            "has": ["Scenario Ogre"]
          }
        }
      ]
    },
    {
      "id": "trailblazers-boots-blockable",
      "title": "Trailblazer's Boots: blockable when the defender controls only basic lands",
      "clauses": [1],
      "instructions": [
