{
  "schemaVersion": 1,
  "card": "Goblin King",
  "supportCards": [
    {
      "name": "Scenario Goblin",
      "typeLine": "Creature — Goblin",
      "manaCost": "{R}",
      "power": "1",
      "toughness": "1"
    },
    {
      "name": "Scenario Ogre",
      "typeLine": "Creature — Ogre",
      "manaCost": "{2}{R}",
      "power": "3",
      "toughness": "3"
    }
  ],
  "scenarios": [
    {
      "id": "goblin-king-walker-unblockable",
      "title": "Goblin King: another Goblin gains the landwalk and can't be blocked",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Goblin only; Goblin King stays home.",
        "P2 controls a Mountain and Scenario Ogre."
      ],
      "expectedOutcome": "P2 is never asked to block; Scenario Goblin deals 2 damage.",
      "seats": {
        "P1": {
          "battlefield": ["Goblin King", "Scenario Goblin"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Mountain"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["__no_attack__", "P2"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Ogre"]
          }
        }
      ]
    },
    {
      "id": "goblin-king-no-matching-land",
      "title": "Goblin King: without a Mountain the Goblin can be blocked",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Goblin only; P2 controls a Island (not a Mountain) and Scenario Ogre.",
        "P2 blocks with Scenario Ogre."
      ],
      "expectedOutcome": "The block is legal: Scenario Goblin dies and P2 takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Goblin King", "Scenario Goblin"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Island"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["__no_attack__", "P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Goblin"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Scenario Goblin"]
          }
        }
      ]
    },
    {
      "id": "goblin-king-lord-itself-blockable",
      "title": "Goblin King: the lord itself does not gain the landwalk",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Goblin King only; P2 controls a Mountain and Scenario Ogre.",
        "P2 blocks with Scenario Ogre."
      ],
      "expectedOutcome": "\"Other\" excludes the lord: it is blockable, so P2 is asked to block and takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Goblin King", "Scenario Goblin"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Mountain"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2", "__no_attack__"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Goblin King"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "event": {
            "type": "block",
            "count": 1
          }
        }
      ]
    }
  ]
}
