{
  "schemaVersion": 1,
  "card": "Electrickery",
  "supportCards": [
    {
      "name": "Scenario Squirrel",
      "typeLine": "Creature — Squirrel",
      "manaCost": "{G}",
      "power": "1",
      "toughness": "1"
    },
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    }
  ],
  "scenarios": [
    {
      "id": "electrickery-target",
      "title": "Electrickery: 1 damage to a creature you don't control",
      "clauses": [1],
      "instructions": ["Cast Electrickery targeting P2's Scenario Squirrel."],
      "expectedOutcome": "P2's Scenario Squirrel dies; P2's other Squirrel and your own are untouched.",
      "seats": {
        "P1": { "hand": ["Electrickery"], "battlefield": ["Mountain", "Scenario Squirrel"] },
        "P2": { "battlefield": ["Scenario Squirrel", "Scenario Bear"] }
      },
      "script": [
        { "player": "P1", "choose": "/^Cast Electrickery/", "targets": ["Scenario Bear"] }
      ],
      "expect": [
        { "zone": { "player": "P1", "zone": "battlefield", "has": ["Scenario Squirrel"] } },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Squirrel", "Scenario Bear"]
          }
        },
        { "event": { "type": "damage", "count": 1, "payload": "Scenario Bear" } }
      ]
    },
    {
      "id": "electrickery-overload",
      "title": "Electrickery overloaded: 1 damage to each creature you don't control",
      "clauses": [1, 2],
      "instructions": ["Cast Electrickery for its overload cost."],
      "expectedOutcome": "Each Squirrel P2 and P3 control dies and P2's Scenario Bear survives with 1 damage; your Squirrel is untouched.",
      "seats": {
        "P1": {
          "hand": ["Electrickery"],
          "battlefield": ["Mountain", "Mountain", "Scenario Squirrel"]
        },
        "P2": { "battlefield": ["Scenario Squirrel", "Scenario Bear"] },
        "P3": { "battlefield": ["Scenario Squirrel"] }
      },
      "script": [{ "player": "P1", "choose": "/^Cast Electrickery.*[Oo]verload/" }],
      "expect": [
        { "zone": { "player": "P1", "zone": "battlefield", "has": ["Scenario Squirrel"] } },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"],
            "lacks": ["Scenario Squirrel"]
          }
        },
        { "zone": { "player": "P3", "zone": "graveyard", "has": ["Scenario Squirrel"] } },
        { "event": { "type": "damage", "count": 3 } }
      ]
    }
  ]
}
