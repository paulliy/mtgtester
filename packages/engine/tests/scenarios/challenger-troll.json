{
  "schemaVersion": 1,
  "card": "Challenger Troll",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Cub",
      "typeLine": "Creature — Bear",
      "manaCost": "{2}{G}",
      "power": "3",
      "toughness": "3"
    }
  ],
  "scenarios": [
    {
      "id": "challenger-troll-single-block-only",
      "title": "Challenger Troll: a creature you control with power 4 or greater can't be blocked by more than one creature",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Challenger Troll.",
        "P2 declares both Scenario Bears as blockers, twice."
      ],
      "expectedOutcome": "Only one blocker is applied: Challenger Troll survives, kills it, and P2 takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Challenger Troll"]
        },
        "P2": {
          "battlefield": ["Scenario Bear", "Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Challenger Troll", "Challenger Troll"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Challenger Troll", "Challenger Troll"]
        }
      ],
      "expect": [
        {
          "event": {
            "type": "block",
            "count": 1
          }
        },
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Challenger Troll"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "challenger-troll-double-block-allowed",
      "title": "Challenger Troll: a creature with power 3 can still be double-blocked",
      "clauses": [1],
      "instructions": ["Attack P2 with Scenario Cub.", "P2 blocks it with both Scenario Bears."],
      "expectedOutcome": "Both blocks are legal: Scenario Cub dies.",
      "seats": {
        "P1": {
          "battlefield": [
            {
              "card": "Challenger Troll",
              "tapped": true
            },
            "Scenario Cub"
          ]
        },
        "P2": {
          "battlefield": ["Scenario Bear", "Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Cub", "Scenario Cub"]
        },
        {
          "player": "P1",
          "choose": "/^All \\d+ damage/"
        }
      ],
      "expect": [
        {
          "event": {
            "type": "block",
            "count": 2
          }
        },
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Scenario Cub"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    }
  ]
}
