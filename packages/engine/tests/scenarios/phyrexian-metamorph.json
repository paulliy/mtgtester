{
  "schemaVersion": 1,
  "card": "Phyrexian Metamorph",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Rock",
      "typeLine": "Artifact",
      "manaCost": "{2}",
      "oracleText": "{T}: Add {C}."
    },
    {
      "name": "Scenario Charm",
      "typeLine": "Enchantment",
      "manaCost": "{1}{W}",
      "oracleText": ""
    },
    {
      "name": "Scenario Shatter",
      "typeLine": "Instant",
      "manaCost": "{R}",
      "oracleText": "Destroy target artifact."
    },
    {
      "name": "Scenario Imp",
      "typeLine": "Creature — Imp",
      "manaCost": "{1}",
      "power": "1",
      "toughness": "1"
    }
  ],
  "scenarios": [
    {
      "id": "metamorph-copies-creature-as-artifact",
      "title": "Phyrexian Metamorph: enter as a copy of an opponent's creature, which is also an artifact",
      "clauses": [1, 2],
      "instructions": [
        "Cast Phyrexian Metamorph and have it enter as a copy of P2's Scenario Bear.",
        "Cast Scenario Shatter on your copy: as an artifact, it can be targeted."
      ],
      "expectedOutcome": "Your Scenario Bear copy is destroyed by Scenario Shatter, and Phyrexian Metamorph goes to your graveyard; P2's Scenario Bear stays.",
      "seats": {
        "P1": {
          "hand": ["Phyrexian Metamorph", "Scenario Shatter"],
          "battlefield": ["Island", "Island", "Island", "Island", "Mountain"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        { "player": "P1", "choose": "/^Cast Phyrexian Metamorph/" },
        { "player": "P1", "choose": "Copy Scenario Bear" },
        { "player": "P1", "choose": "/^Cast Scenario Shatter/", "targets": ["Scenario Bear"] }
      ],
      "expect": [
        { "zone": { "player": "P1", "zone": "graveyard", "has": ["Phyrexian Metamorph"] } },
        { "zone": { "player": "P1", "zone": "battlefield", "lacks": ["Scenario Bear"] } },
        { "zone": { "player": "P2", "zone": "battlefield", "has": ["Scenario Bear"] } },
        { "event": { "type": "becomeCopy", "count": 1, "payload": "Scenario Bear" } }
      ]
    },
    {
      "id": "metamorph-copies-artifact",
      "title": "Phyrexian Metamorph: enter as a copy of an artifact, and tap it for mana",
      "clauses": [1, 2],
      "instructions": [
        "Cast Phyrexian Metamorph and have it enter as a copy of P2's Scenario Rock.",
        "Cast Scenario Imp with your copy's mana."
      ],
      "expectedOutcome": "You control a Scenario Rock copy, tapped to cast Scenario Imp.",
      "seats": {
        "P1": {
          "hand": ["Phyrexian Metamorph", "Scenario Imp"],
          "battlefield": ["Island", "Island", "Island", "Island"]
        },
        "P2": {
          "battlefield": ["Scenario Rock"]
        }
      },
      "script": [
        { "player": "P1", "choose": "/^Cast Phyrexian Metamorph/" },
        { "player": "P1", "choose": "Copy Scenario Rock" },
        { "player": "P1", "choose": "/^Cast Scenario Imp/" }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Rock", "Scenario Imp"]
          }
        },
        { "tapped": { "card": "Scenario Rock", "player": "P1", "equals": true } },
        { "tapped": { "card": "Scenario Rock", "player": "P2", "equals": false } }
      ]
    },
    {
      "id": "metamorph-enters-normally",
      "title": "Phyrexian Metamorph: entering as itself, it is a 0/0 and dies",
      "clauses": [2],
      "instructions": ["Cast Phyrexian Metamorph and have it enter normally instead of as a copy."],
      "expectedOutcome": "Phyrexian Metamorph enters as a 0/0 and goes to your graveyard.",
      "seats": {
        "P1": {
          "hand": ["Phyrexian Metamorph"],
          "battlefield": ["Island", "Island", "Island", "Island"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        { "player": "P1", "choose": "/^Cast Phyrexian Metamorph/" },
        { "player": "P1", "choose": "Enter normally" }
      ],
      "expect": [
        { "zone": { "player": "P1", "zone": "graveyard", "has": ["Phyrexian Metamorph"] } },
        { "event": { "type": "becomeCopy", "count": 0 } }
      ]
    },
    {
      "id": "metamorph-only-artifacts-and-creatures",
      "title": "Phyrexian Metamorph: a land or an enchantment is not offered to copy",
      "clauses": [2],
      "instructions": [
        "Cast Phyrexian Metamorph: only Scenario Bear and Scenario Rock are offered to copy."
      ],
      "expectedOutcome": "The copy choice offers Scenario Bear, Scenario Rock and entering normally, never the Forest or Scenario Charm.",
      "seats": {
        "P1": {
          "hand": ["Phyrexian Metamorph"],
          "battlefield": ["Island", "Island", "Island", "Island"]
        },
        "P2": {
          "battlefield": ["Scenario Bear", "Scenario Rock", "Scenario Charm", "Forest"]
        }
      },
      "script": [
        { "player": "P1", "choose": "/^Cast Phyrexian Metamorph/" },
        { "player": "P1", "choose": "Copy Scenario Bear" }
      ],
      "expect": [{ "zone": { "player": "P1", "zone": "battlefield", "has": ["Scenario Bear"] } }]
    },
    {
      "id": "metamorph-pays-life",
      "title": "Phyrexian Metamorph: pay 2 life for its Phyrexian blue",
      "clauses": [1],
      "instructions": [
        "With only three lands, cast Phyrexian Metamorph paying 2 life for {U/P}, and copy Scenario Bear."
      ],
      "expectedOutcome": "You are at 38 life and control a Scenario Bear copy.",
      "seats": {
        "P1": {
          "hand": ["Phyrexian Metamorph"],
          "battlefield": ["Mountain", "Mountain", "Mountain"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        { "player": "P1", "choose": "/^Cast Phyrexian Metamorph/" },
        { "player": "P1", "choose": "Copy Scenario Bear" }
      ],
      "expect": [
        { "life": { "player": "P1", "equals": 38 } },
        { "zone": { "player": "P1", "zone": "battlefield", "has": ["Scenario Bear"] } }
      ]
    }
  ]
}
