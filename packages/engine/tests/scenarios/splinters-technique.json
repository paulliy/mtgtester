{
  "schemaVersion": 1,
  "card": "Splinter's Technique",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Wall",
      "typeLine": "Creature — Wall",
      "manaCost": "{1}",
      "power": "0",
      "toughness": "4"
    }
  ],
  "scenarios": [
    {
      "id": "splinters-technique-sneak",
      "title": "Splinter's Technique: sneak-cast for its sneak cost, returning the unblocked attacker",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Bear; P2 has no blockers.",
        "In the declare blockers step, cast Splinter's Technique for its sneak cost, returning Scenario Bear to hand."
      ],
      "expectedOutcome": "The unblocked Scenario Bear returns to P1's hand, P1 pays only {1}{B}, and searches for a card.",
      "seats": {
        "P1": {
          "hand": ["Splinter's Technique"],
          "battlefield": ["Scenario Bear", "Swamp", "Swamp"],
          "libraryTop": ["Island", "Island"]
        },
        "P2": {}
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P1",
          "choose": "/^Cast Splinter's Technique .*\\(alternate cost\\)$/"
        },
        {
          "player": "P1",
          "choose": "Island"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Scenario Bear", "Island"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "lacks": ["Scenario Bear"]
          }
        },
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "splinters-technique-sneak-blocked",
      "title": "Splinter's Technique: no sneak cast once the attacker is blocked",
      "clauses": [1],
      "instructions": ["Attack P2 with Scenario Bear; P2 blocks it with Scenario Wall."],
      "expectedOutcome": "Sneak is not offered, since no unblocked attacker exists; Splinter's Technique stays in hand and P1 draws or searches nothing.",
      "seats": {
        "P1": {
          "hand": ["Splinter's Technique"],
          "battlefield": ["Scenario Bear", "Swamp", "Swamp"],
          "libraryTop": ["Island", "Island"]
        },
        "P2": {
          "battlefield": ["Scenario Wall"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Bear"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Splinter's Technique"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        },
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "splinters-technique-sneak-main-phase",
      "title": "Splinter's Technique: sneak is not offered in the main phase",
      "clauses": [1],
      "instructions": [
        "Look at P1's options in the precombat main phase with Scenario Bear on the battlefield."
      ],
      "expectedOutcome": "Only the printed cost is offered; no (alternate cost) action appears, because sneak is castable only in the declare blockers step.",
      "seats": {
        "P1": {
          "hand": ["Splinter's Technique"],
          "battlefield": ["Scenario Bear", "Swamp", "Swamp"]
        },
        "P2": {}
      },
      "script": [],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Splinter's Technique"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        }
      ]
    }
  ]
}
