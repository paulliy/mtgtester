  "scenarios": [
    {
      "id": "gixian-puppeteer-returns-another-small-creature",
      "title": "Gixian Puppeteer: when it dies, another creature card with mana value 3 or less returns",
      "clauses": [2],
      "instructions": [
        "Cast Scenario Smite on your own Gixian Puppeteer.",
        "Its death trigger targets Scenario Bear (mana value 2) in your graveyard; Scenario Ogre (mana value 4) is not a legal target."
      ],
      "expectedOutcome": "Scenario Bear returns to the battlefield; Gixian Puppeteer and Scenario Ogre stay in the graveyard.",
      "seats": {
        "P1": {
          "hand": ["Scenario Smite"],
          "battlefield": ["Gixian Puppeteer", "Swamp"],
          "graveyard": ["Scenario Bear", "Scenario Ogre"]
        },
        "P2": {}
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Scenario Smite/",
          "targets": ["Gixian Puppeteer"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Gixian Puppeteer", "Scenario Ogre"],
            "lacks": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "gixian-puppeteer-cannot-return-itself",
      "title": "Gixian Puppeteer: \"another\" means it cannot return itself",
      "clauses": [2],
      "instructions": [
        "Cast Scenario Smite on your own Gixian Puppeteer with no other creature card in your graveyard."
