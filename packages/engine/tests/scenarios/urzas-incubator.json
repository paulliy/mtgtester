{
  "schemaVersion": 1,
  "card": "Urza's Incubator",
  "supportCards": [
    {
      "name": "Scenario Beast",
      "typeLine": "Creature \u2014 Beast",
      "manaCost": "{3}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Elk",
      "typeLine": "Creature \u2014 Elk",
      "manaCost": "{3}{G}",
      "power": "2",
      "toughness": "2"
    }
  ],
  "scenarios": [
    {
      "id": "incubator-chosen-type-cheaper",
      "title": "Urza's Incubator: choose Beast, and a Beast spell costs {2} less",
      "clauses": [1, 2],
      "instructions": [
        "Cast Urza's Incubator and choose Beast.",
        "Cast Scenario Beast ({3}{G}) with your two remaining Forests."
      ],
      "expectedOutcome": "Scenario Beast is on the battlefield, cast for {1}{G}.",
      "seats": {
        "P1": {
          "hand": ["Urza's Incubator", "Scenario Beast", "Scenario Elk"],
          "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Urza's Incubator/"
        },
        {
          "player": "P1",
          "choose": "Beast",
          "prompt": "/choose a creature type/"
        },
        {
          "player": "P1",
          "choose": "/^Cast Scenario Beast/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Urza's Incubator", "Scenario Beast"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Scenario Elk"]
          }
        }
      ]
    },
    {
      "id": "incubator-other-type-full-price",
      "title": "Urza's Incubator: a creature of another type costs full price",
      "clauses": [2],
      "instructions": [
        "Cast Urza's Incubator and choose Beast: Scenario Elk ({3}{G}) cannot be cast with two Forests."
      ],
      "expectedOutcome": "Scenario Elk stays in your hand.",
      "seats": {
        "P1": {
          "hand": ["Urza's Incubator", "Scenario Elk", "Scenario Beast"],
          "battlefield": ["Forest", "Forest", "Forest", "Forest", "Forest"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Urza's Incubator/"
        },
        {
          "player": "P1",
          "choose": "Beast",
          "prompt": "/choose a creature type/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Scenario Elk", "Scenario Beast"]
          }
        }
      ]
    },
    {
      "id": "incubator-reduces-opponents-spells",
      "title": "Urza's Incubator: an opponent's spell of the chosen type costs {2} less too",
      "clauses": [2],
      "instructions": [
        "Cast Urza's Incubator and choose Beast, then pass the turn.",
        "P2 casts Scenario Beast ({3}{G}) with two Forests."
      ],
      "expectedOutcome": "P2's Scenario Beast is on P2's battlefield.",
      "seats": {
        "P1": {
          "hand": ["Urza's Incubator", "Scenario Beast", "Scenario Elk"],
          "battlefield": ["Forest", "Forest", "Forest"]
        },
        "P2": {
          "hand": ["Scenario Beast"],
          "battlefield": ["Forest", "Forest"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Urza's Incubator/"
        },
        {
          "player": "P1",
          "choose": "Beast",
          "prompt": "/choose a creature type/"
        },
        {
          "player": "P2",
          "choose": "/^Cast Scenario Beast/"
        }
      ],
      "continue": {
        "throughCombat": true,
        "toPostcombatMain": true,
        "toEndStep": true,
        "throughNextTurn": true
      },
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Beast"]
          }
        }
      ]
    }
  ]
}
