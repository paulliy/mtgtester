          "hand": ["Scenario Opt", "Flusterstorm"],
          "battlefield": ["Island", "Island"]
        },
        "P2": {
          "hand": ["Scenario Bolt"],
          "battlefield": ["Mountain"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Scenario Opt/"
        },
        {
          "player": "P2",
          "choose": "/^Cast Scenario Bolt/",
          "targets": ["P1"]
        },
        {
          "player": "P1",
          "choose": "/^Cast Flusterstorm/",
          "targets": ["Scenario Bolt"]
        },
        {
          "player": "P1",
          "choose": "/^Keep Scenario Bolt/"
        },
        {
          "player": "P1",
          "choose": "/^Keep Scenario Bolt/"
