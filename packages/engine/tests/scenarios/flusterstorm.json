          "player": "P1",
          "choose": "/^Cast Flusterstorm/",
          "targets": ["Scenario Bolt"]
        },
        {
          "player": "P1",
          "choose": "/^Keep Scenario Bolt/"
        },
        {
          "player": "P2",
          "choose": "/^Pay/"
        },
        {
          "player": "P2",
          "choose": "/^Pay/"
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P1",
            "equals": 37
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
