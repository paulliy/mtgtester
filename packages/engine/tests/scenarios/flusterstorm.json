          "life": {
            "player": "P1",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bolt"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Flusterstorm", "Scenario Opt"]
          }
        },
        {
