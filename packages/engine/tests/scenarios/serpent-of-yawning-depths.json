    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Kraken",
      "typeLine": "Creature — Kraken",
      "manaCost": "{2}{U}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Ogre",
      "typeLine": "Creature — Ogre",
      "manaCost": "{2}{R}",
      "power": "3",
      "toughness": "3"
    }
  ],
  "scenarios": [
    {
      "id": "serpent-of-yawning-depths-kraken-may-block",
      "title": "Serpent of Yawning Depths: a Kraken may block it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Serpent of Yawning Depths.",
        "P2 blocks it with Scenario Kraken."
      ],
      "expectedOutcome": "The block is legal: Scenario Kraken dies and P2 takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Serpent of Yawning Depths"]
        },
        "P2": {
          "battlefield": ["Scenario Kraken"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Serpent of Yawning Depths"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Kraken"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "serpent-of-yawning-depths-bear-cannot-block",
      "title": "Serpent of Yawning Depths: a Bear can't block it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Serpent of Yawning Depths while P2 controls only Scenario Bear."
      ],
      "expectedOutcome": "P2 is never asked to block; Serpent deals 6 damage.",
      "seats": {
        "P1": {
          "battlefield": ["Serpent of Yawning Depths"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 34
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "serpent-of-yawning-depths-other-creature-unaffected",
      "title": "Serpent of Yawning Depths: a creature that is not a Kraken, Leviathan, Octopus or Serpent is unaffected",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Ogre (not a Kraken, Leviathan, Octopus or Serpent) while P2 controls Scenario Bear.",
        "P2 blocks it with Scenario Bear."
      ],
      "expectedOutcome": "The Ogre may be blocked by a Bear: the Bear dies.",
      "seats": {
        "P1": {
          "battlefield": [
            "Serpent of Yawning Depths",
            {
              "card": "Scenario Ogre"
            }
          ]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["__no_attack__", "P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Ogre"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bear"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    }
  ]
