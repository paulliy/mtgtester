{
  "schemaVersion": 1,
  "card": "Emerge Unscathed",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Goblin",
      "typeLine": "Creature — Goblin",
      "manaCost": "{R}",
      "power": "1",
      "toughness": "1"
    }
  ],
  "scenarios": [
    {
      "id": "emerge-unscathed-protection-from-chosen-color",
      "title": "Emerge Unscathed: the creature gains protection from the chosen color, so a creature of that color can't block it",
      "clauses": [1],
      "instructions": [
        "Cast Emerge Unscathed on your Scenario Bear and choose red.",
        "Attack P2 with Scenario Bear; P2's only creature is the red Scenario Goblin."
      ],
      "expectedOutcome": "Scenario Bear has protection from red, so the Goblin cannot block it: P2 takes 2 damage.",
      "seats": {
        "P1": {
          "hand": ["Emerge Unscathed"],
          "battlefield": ["Plains", "Scenario Bear"]
        },
        "P2": {
          "battlefield": ["Scenario Goblin"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Emerge Unscathed/",
          "targets": ["Scenario Bear"]
        },
        {
          "player": "P1",
          "choose": "Protection from R"
        },
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Goblin"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "emerge-unscathed-other-color-can-be-blocked",
      "title": "Emerge Unscathed: protection is only from the chosen color, so a creature of another color can still block",
      "clauses": [1],
      "instructions": [
        "Cast Emerge Unscathed on your Scenario Bear and choose green.",
        "Attack P2 with Scenario Bear; P2's only creature is the red Scenario Goblin, which blocks."
      ],
      "expectedOutcome": "Scenario Bear has protection from green only, so the red Scenario Goblin blocks it and dies: P2 takes no damage.",
      "seats": {
        "P1": {
          "hand": ["Emerge Unscathed"],
          "battlefield": ["Plains", "Scenario Bear"]
        },
        "P2": {
          "battlefield": ["Scenario Goblin"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Emerge Unscathed/",
          "targets": ["Scenario Bear"]
        },
        {
          "player": "P1",
          "choose": "Protection from G"
        },
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Bear"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Goblin"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    }
  ]
}
