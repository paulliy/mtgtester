          "hand": ["Kismet"],
          "battlefield": ["Plains", "Plains", "Plains", "Plains"]
        },
        "P2": {
          "hand": ["Mountain", "Scenario Bear", "Scenario Relic"],
          "battlefield": ["Forest", "Forest", "Forest"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Kismet/"
        },
        {
          "player": "P2",
          "choose": "/^Play Mountain/"
        },
        {
          "player": "P2",
          "choose": "/^Cast Scenario Bear/"
        },
        {
          "player": "P2",
          "choose": "/^Cast Scenario Relic/"
        }
      ],
      "expect": [
        {
          "tapped": {
            "card": "Mountain",
            "equals": true,
            "player": "P2"
          }
        },
        {
          "tapped": {
            "card": "Scenario Bear",
            "equals": true,
            "player": "P2"
          }
        },
        {
          "tapped": {
            "card": "Scenario Relic",
            "equals": true,
            "player": "P2"
          }
        }
      ]
    },
    {
      "id": "kismet-own-permanents-enter-untapped",
      "title": "Kismet: your own artifacts, creatures and lands enter untapped",
      "clauses": [1],
      "instructions": [
        "With Kismet on the battlefield, play a Mountain and cast Scenario Bear and Scenario Relic."
      ],
      "expectedOutcome": "Your Mountain, Scenario Bear and Scenario Relic enter untapped.",
      "seats": {
        "P1": {
          "hand": ["Mountain", "Scenario Bear", "Scenario Relic"],
          "battlefield": ["Kismet", "Forest", "Forest", "Forest"]
