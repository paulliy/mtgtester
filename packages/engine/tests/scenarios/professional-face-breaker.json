{
  "schemaVersion": 1,
  "card": "Professional Face-Breaker",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature \u2014 Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Trinket",
      "typeLine": "Artifact",
      "manaCost": "{1}",
      "oracleText": ""
    }
  ],
  "scenarios": [
    {
      "id": "face-breaker-treasure-then-play",
      "title": "Professional Face-Breaker: combat damage makes a Treasure; sacrifice it to play the top card",
      "clauses": [2, 3],
      "instructions": [
        "Attack P2 with Professional Face-Breaker.",
        "After combat damage, sacrifice the Treasure to exile the top card of your library.",
        "Play the exiled Forest."
      ],
      "expectedOutcome": "P2 loses 2 life, you get a Treasure, sacrifice it to exile the Forest on top of your library, and play the Forest from exile.",
      "seats": {
        "P1": {
          "battlefield": ["Professional Face-Breaker"],
          "libraryTop": ["Forest", "Scenario Bear"]
        },
        "P2": {}
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P1",
          "choose": "/Sacrifice a Treasure/"
        },
        {
          "player": "P1",
          "choose": "/^Play Forest/"
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Professional Face-Breaker", "Forest"],
            "lacks": ["Treasure"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "exile",
            "lacks": ["Forest"]
          }
        },
        {
          "event": {
            "type": "tokenCreated",
            "count": 1,
            "payload": "Treasure"
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "exile",
            "lacks": ["Scenario Bear"]
          }
        }
      ],
      "continue": {
        "throughCombat": true,
        "toPostcombatMain": true
      }
    },
    {
      "id": "face-breaker-double-blocked",
      "title": "Professional Face-Breaker: blocked by two creatures, no player is dealt damage and no Treasure is made",
      "clauses": [1, 2],
      "instructions": [
        "Attack P2 with Professional Face-Breaker.",
        "As P2, block it with both Scenario Bears."
      ],
      "expectedOutcome": "P2's life stays 40 and you get no Treasure.",
      "seats": {
        "P1": {
          "battlefield": ["Professional Face-Breaker"]
        },
        "P2": {
          "battlefield": ["Scenario Bear", "Scenario Bear"]
        }
      },
      "continue": {
        "throughCombat": true
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "/blockers/",
          "targets": ["Professional Face-Breaker", "Professional Face-Breaker"]
        },
        {
          "player": "P1",
          "choose": "/^All 2 damage to Scenario Bear/"
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "lacks": ["Treasure"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "face-breaker-menace-lone-blocker",
      "title": "Professional Face-Breaker: one creature alone cannot block it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Professional Face-Breaker.",
        "As P2, try to block it with your one Scenario Bear: the block is refused.",
        "Declare no blockers instead."
      ],
      "expectedOutcome": "The lone block is refused, Face-Breaker deals 2 damage to P2 and you get a Treasure.",
      "seats": {
        "P1": {
          "battlefield": ["Professional Face-Breaker"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "continue": {
        "throughCombat": true
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "/blockers/",
          "targets": ["Professional Face-Breaker"]
        },
        {
          "player": "P2",
          "choose": "/blockers/",
          "prompt": "/fix the flagged/",
          "targets": ["__no_block__"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Treasure"]
          }
        }
      ]
    },
    {
      "id": "face-breaker-no-treasure-no-sacrifice",
      "title": "Professional Face-Breaker: with no Treasure, another artifact cannot pay the sacrifice",
      "clauses": [3],
      "instructions": [
        "With Scenario Trinket but no Treasure, look for Face-Breaker's sacrifice ability; Scenario Bear in hand is the only spell you can cast."
      ],
      "expectedOutcome": "The ability is not offered; nothing is exiled.",
      "seats": {
        "P1": {
          "hand": ["Scenario Bear"],
          "battlefield": ["Professional Face-Breaker", "Scenario Trinket", "Forest", "Forest"]
        }
      },
      "script": [],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Trinket"]
          }
        }
      ]
    },
    {
      "id": "face-breaker-permission-ends",
      "title": "Professional Face-Breaker: the exiled card can be played only this turn",
      "clauses": [3],
      "instructions": [
        "Attack P2 with Professional Face-Breaker.",
        "Sacrifice the Treasure to exile Scenario Bear, and don't cast it.",
        "Pass until your next turn's precombat main phase."
      ],
      "expectedOutcome": "Scenario Bear stays in exile and cannot be cast on your next turn.",
      "seats": {
        "P1": {
          "battlefield": ["Professional Face-Breaker", "Forest", "Forest"],
          "libraryTop": ["Scenario Bear"]
        }
      },
      "continue": {
        "throughCombat": true,
        "throughPrecombatMains": 4
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P1",
          "choose": "/Sacrifice a Treasure/"
        }
      ],
      "end": {
        "turn": 8
      },
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "exile",
            "has": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "face-breaker-one-treasure",
      "title": "Professional Face-Breaker: one Treasure per combat damage step, without being asked",
      "clauses": [2],
      "instructions": ["Attack P2 with Professional Face-Breaker and Scenario Bear."],
      "expectedOutcome": "P2 loses 4 life and you get exactly one Treasure, with no choice to make.",
      "seats": {
        "P1": {
          "battlefield": ["Professional Face-Breaker", "Scenario Bear"]
        }
      },
      "continue": {
        "throughCombat": true
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2", "P2"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 36
          }
        },
        {
          "event": {
            "type": "tokenCreated",
            "count": 1,
            "payload": "Treasure"
          }
        }
      ]
    },
    {
      "id": "face-breaker-opponent-creature-no-treasure",
      "title": "Professional Face-Breaker: an opponent's creature dealing combat damage makes no Treasure",
      "clauses": [2],
      "instructions": ["On P2's turn, P2 attacks you with Scenario Bear.", "Don't block."],
      "expectedOutcome": "You lose 2 life and nobody gets a Treasure.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "battlefield": ["Professional Face-Breaker"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "continue": {
        "throughCombat": true
      },
      "script": [
        {
          "player": "P2",
          "choose": "Declare attackers",
          "targets": ["P1"]
        },
        {
          "player": "P1",
          "choose": "/blockers/",
          "targets": ["__no_block__"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P1",
            "equals": 38
          }
        },
        {
          "event": {
            "type": "tokenCreated",
            "count": 0
          }
        }
      ]
    }
  ]
}
