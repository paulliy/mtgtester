          "choose": "/^Targets for Gonti/",
          "targets": ["P2"]
        },
        {
          "player": "P1",
          "choose": "Exile face down Scenario Elk"
        }
      ],
      "continue": {
        "throughCombat": true,
        "toPostcombatMain": true,
        "toEndStep": true,
        "throughNextTurn": true
      },
      "expect": [
