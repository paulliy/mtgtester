      "id": "ragavan-hit-cast",
      "title": "Ragavan: connect, make a Treasure, and cast the exiled card with it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Ragavan.",
        "After combat damage, cast the exiled Scenario Spark at P2, paying {R} with the Treasure."
      ],
      "expectedOutcome": "P2 takes 2 from Ragavan and 1 from its own Scenario Spark, which goes to P2's graveyard.",
      "continue": {
        "throughCombat": true
      },
      "seats": {
        "P1": {
          "battlefield": ["Ragavan, Nimble Pilferer"]
        },
        "P2": {
          "libraryTop": ["Scenario Spark"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P1",
          "choose": "/^Cast Scenario Spark/",
          "targets": ["P2"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 37
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Spark"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "lacks": ["Treasure"]
          }
        }
      ]
    },
