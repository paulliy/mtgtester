      "expectedOutcome": "Two Prosperous Bandit are on the battlefield: the original and a 1/1 token copy.",
      "seats": {
        "P1": {
          "hand": ["Prosperous Bandit"],
          "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]
        },
        "P2": {}
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Prosperous Bandit \\(\\{3\\}\\{R\\}\\) — offspring 1$/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Prosperous Bandit", "Prosperous Bandit"]
          }
        }
      ]
    },
    {
      "id": "prosperous-bandit-offspring-declined",
      "title": "Prosperous Bandit: casting it for its normal cost makes no token",
