      ],
      "expectedOutcome": "Only the original Prosperous Bandit is on the battlefield; no token copy is created.",
      "seats": {
        "P1": {
          "hand": ["Prosperous Bandit"],
          "battlefield": ["Mountain", "Mountain", "Mountain", "Mountain"]
        },
        "P2": {}
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Prosperous Bandit \\(\\{2\\}\\{R\\}\\)$/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Prosperous Bandit"]
          }
        }
      ]
    }
  ]
