      "instructions": ["Cast Mizzium Mortars targeting P2's Scenario Ox."],
      "expectedOutcome": "Scenario Ox (3/5) takes 4 damage and survives; nothing else is damaged.",
      "seats": {
        "P1": {
          "hand": ["Mizzium Mortars"],
          "battlefield": ["Mountain", "Mountain", "Scenario Bear"]
