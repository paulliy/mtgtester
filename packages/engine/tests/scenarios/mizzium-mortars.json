      "title": "Mizzium Mortars overloaded: 4 damage to each creature you don't control, hexproof or not",
      "clauses": [1, 2],
      "instructions": ["Cast Mizzium Mortars for its overload cost."],
      "expectedOutcome": "Every creature P2 and P3 control takes 4 damage, the hexproof one included; P1's Scenario Bear is untouched.",
      "seats": {
        "P1": {
          "hand": ["Mizzium Mortars"],
          "battlefield": [
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain",
            "Mountain",
            "Scenario Bear"
          ]
        },
        "P2": {
          "battlefield": ["Scenario Bear", "Scenario Ox"]
        },
        "P3": {
          "battlefield": ["Scenario Hexbear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Mizzium Mortars.*[Oo]verload/"
