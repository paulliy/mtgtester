      "expectedOutcome": "A basic land is offered and put into your hand; Scenario Sprite (mana value 1) is not offered and stays in the library.",
      "seats": {
        "P1": {
          "hand": ["Tolaria West"],
          "battlefield": ["Island", "Island", "Island"],
          "libraryTop": ["Scenario Sprite"]
        }
      },
      "script": [
        {
          "player": "P1",
