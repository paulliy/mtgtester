        "P1": {
          "hand": ["Tolaria West"],
          "battlefield": ["Island", "Island", "Island"],
          "libraryTop": ["Scenario Sprite", "Scenario Trinket"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Tolaria West \\(hand\\): Transmute/"
        },
        {
          "player": "P1",
          "choose": "/Scenario Trinket/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Scenario Trinket"],
            "lacks": ["Tolaria West"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Tolaria West"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "library",
            "has": ["Scenario Sprite"],
            "lacks": ["Scenario Trinket"]
          }
        },
        {
