            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "zodiac-monkey-blockable-without-forest",
