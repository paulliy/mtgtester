      "instructions": [
        "With no lands, cast Scenario Sapling; Elvish Spirit Guide pays for it from your hand."
      ],
      "expectedOutcome": "Elvish Spirit Guide is exiled from your hand and Scenario Sapling resolves.",
      "seats": {
