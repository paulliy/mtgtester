            "has": ["Elvish Spirit Guide"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "lacks": ["Elvish Spirit Guide"]
          }
        }
      ]
    },
    {
      "id": "elvish-spirit-guide-board-first",
      "title": "Elvish Spirit Guide: an untapped Forest pays before the hand card is spent",
      "clauses": [1],
      "instructions": ["With a Forest, cast Scenario Sapling."],
      "expectedOutcome": "The Forest pays; Elvish Spirit Guide stays in your hand.",
      "seats": {
        "P1": {
          "hand": ["Elvish Spirit Guide", "Scenario Sapling"],
          "battlefield": ["Forest"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Scenario Sapling/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Sapling"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Elvish Spirit Guide"]
          }
        },
        {
          "tapped": {
            "card": "Forest",
            "equals": true
          }
        }
      ]
    }
