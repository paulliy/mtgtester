{
  "schemaVersion": 1,
  "card": "Assert Authority",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Trinket",
      "typeLine": "Artifact",
      "manaCost": "{1}"
    }
  ],
  "scenarios": [
    {
      "id": "assert-authority-counters-and-exiles",
      "title": "Assert Authority: counters a spell and exiles it instead of putting it into the graveyard",
      "clauses": [2],
      "instructions": [
        "P2 casts Scenario Bear on their turn; P1 responds with Assert Authority (affinity: three artifacts) targeting it."
      ],
      "expectedOutcome": "Scenario Bear is exiled, not put into P2's graveyard.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "hand": ["Assert Authority"],
          "battlefield": [
            "Island",
            "Island",
            "Island",
            "Island",
            "Scenario Trinket",
            "Scenario Trinket",
            "Scenario Trinket"
          ]
        },
        "P2": {
          "hand": ["Scenario Bear"],
          "battlefield": ["Forest", "Forest"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "/^Cast Scenario Bear/"
        },
        {
          "player": "P1",
          "choose": "/^Cast Assert Authority/",
          "targets": ["Scenario Bear"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "exile",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "lacks": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "lacks": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Assert Authority"]
          }
        }
      ]
    },
    {
      "id": "assert-authority-affinity-counts-only-your-artifacts",
      "title": "Assert Authority: only your own artifacts reduce its cost",
      "clauses": [1],
      "instructions": [
        "P2 casts Scenario Bear on their turn while P2 controls three artifacts and P1 controls four Islands and no artifacts; P1 cannot afford Assert Authority."
      ],
      "expectedOutcome": "Assert Authority is not castable (it costs {5}{U}{U}), so Scenario Bear resolves.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "hand": ["Assert Authority"],
          "battlefield": ["Island", "Island", "Island", "Island"]
        },
        "P2": {
          "hand": ["Scenario Bear"],
          "battlefield": [
            "Forest",
            "Forest",
            "Scenario Trinket",
            "Scenario Trinket",
            "Scenario Trinket"
          ]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "/^Cast Scenario Bear/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Assert Authority"]
          }
        }
      ]
    }
  ]
}
