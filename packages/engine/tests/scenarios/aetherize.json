  "scenarios": [
    {
      "id": "aetherize-returns-attackers",
      "title": "Aetherize: every attacking creature returns to its owner's hand",
      "clauses": [1],
      "instructions": [
        "P2 attacks you with Scenario Bear and Scenario Wolf and keeps Scenario Elk home.",
        "Cast Aetherize after attackers are declared."
      ],
      "expectedOutcome": "Scenario Bear and Scenario Wolf return to P2's hand; Scenario Elk and your Scenario Owl stay, and you take no damage.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "hand": ["Aetherize"],
          "battlefield": ["Island", "Island", "Island", "Island", "Scenario Owl"]
        },
        "P2": {
          "battlefield": ["Scenario Bear", "Scenario Wolf", "Scenario Elk"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "Declare attackers",
          "targets": ["P1", "P1", "__no_attack__"]
        },
        {
          "player": "P1",
          "choose": "/^Cast Aetherize/"
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "hand",
            "has": ["Scenario Bear", "Scenario Wolf"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Elk"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Owl"]
          }
        },
        {
          "life": {
            "player": "P1",
            "equals": 40
          }
        }
      ]
    },
    {
      "id": "aetherize-outside-combat",
      "title": "Aetherize: outside combat there are no attacking creatures, so nothing returns",
      "clauses": [1],
      "instructions": ["Cast Aetherize in your main phase."],
      "expectedOutcome": "Every creature stays on the battlefield.",
      "seats": {
        "P1": {
          "hand": ["Aetherize"],
          "battlefield": ["Island", "Island", "Island", "Island", "Scenario Owl"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Aetherize/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Owl"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Aetherize"]
          }
        }
      ]
    }
