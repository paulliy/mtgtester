          "player": "P1",
          "choose": "/^Cast Venom's Hunger/",
          "targets": ["Scenario Bear"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bear"]
          }
        },
        {
          "life": {
            "player": "P1",
            "equals": 42
          }
        }
      ]
    },
    {
