      "clauses": [1],
      "instructions": ["Attack P2 with Scenario Ogre.", "P2 blocks it with both Scenario Bears."],
      "expectedOutcome": "Both blocks are legal: Scenario Ogre dies.",
      "seats": {
        "P1": {
          "battlefield": [
            {
              "card": "Michelangelo, Mutant BFF",
