  "scenarios": [
    {
      "id": "lord-of-atlantis-walker-unblockable",
      "title": "Lord of Atlantis: another Merfolk gains the landwalk and can't be blocked",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Merfolk only; Lord of Atlantis stays home.",
        "P2 controls a Island and Scenario Ogre."
      ],
      "expectedOutcome": "P2 is never asked to block; Scenario Merfolk deals 2 damage.",
      "seats": {
        "P1": {
          "battlefield": ["Lord of Atlantis", "Scenario Merfolk"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Island"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["__no_attack__", "P2"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Ogre"]
          }
        }
      ]
    },
    {
      "id": "lord-of-atlantis-no-matching-land",
      "title": "Lord of Atlantis: without a Island the Merfolk can be blocked",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Merfolk only; P2 controls a Forest (not a Island) and Scenario Ogre.",
        "P2 blocks with Scenario Ogre."
      ],
      "expectedOutcome": "The block is legal: Scenario Merfolk dies and P2 takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Lord of Atlantis", "Scenario Merfolk"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Forest"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["__no_attack__", "P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Merfolk"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Scenario Merfolk"]
          }
        }
      ]
    },
    {
      "id": "lord-of-atlantis-lord-itself-blockable",
      "title": "Lord of Atlantis: the lord itself does not gain the landwalk",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Lord of Atlantis only; P2 controls a Island and Scenario Ogre.",
        "P2 blocks with Scenario Ogre."
      ],
      "expectedOutcome": "\"Other\" excludes the lord: it is blockable, so P2 is asked to block and takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Lord of Atlantis", "Scenario Merfolk"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Island"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2", "__no_attack__"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Lord of Atlantis"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "event": {
