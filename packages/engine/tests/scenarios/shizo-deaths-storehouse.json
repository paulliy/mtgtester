{
  "schemaVersion": 1,
  "card": "Shizo, Death's Storehouse",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Legend",
      "typeLine": "Legendary Creature — Human",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Zombie",
      "typeLine": "Creature — Zombie",
      "manaCost": "{1}{B}",
      "power": "2",
      "toughness": "2"
    }
  ],
  "scenarios": [
    {
      "id": "shizo-deaths-storehouse-fear-green-creature-cannot-block",
      "title": "Shizo: a legendary creature with fear can't be blocked by a green creature",
      "clauses": [2],
      "instructions": [
        "Activate Shizo ({B}, {T}) targeting Scenario Legend.",
        "Attack P2 with Scenario Legend while P2 controls only Scenario Bear (green, nonartifact)."
      ],
      "expectedOutcome": "P2 is never asked to block; Scenario Legend deals 2 damage.",
      "seats": {
        "P1": {
          "battlefield": ["Shizo, Death's Storehouse", "Swamp", "Scenario Legend"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/gains fear/",
          "targets": ["Scenario Legend"]
        },
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "shizo-deaths-storehouse-fear-black-creature-may-block",
      "title": "Shizo: a black creature may block the legendary creature with fear",
      "clauses": [2],
      "instructions": [
        "Activate Shizo ({B}, {T}) targeting Scenario Legend.",
        "Attack P2 with Scenario Legend.",
        "P2 blocks it with Scenario Zombie (black)."
      ],
      "expectedOutcome": "The block is legal: both 2/2 creatures die and P2 takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Shizo, Death's Storehouse", "Swamp", "Scenario Legend"]
        },
        "P2": {
          "battlefield": ["Scenario Zombie"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/gains fear/",
          "targets": ["Scenario Legend"]
        },
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Legend"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Zombie"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Scenario Legend"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "shizo-deaths-storehouse-fear-only-legendary-target",
      "title": "Shizo: only the legendary creature gains fear",
      "clauses": [2],
      "instructions": [
        "Activate Shizo ({B}, {T}) targeting Scenario Legend; Scenario Bear (nonlegendary) is also on the battlefield."
      ],
      "expectedOutcome": "Scenario Legend has fear; Scenario Bear is not a legal target and has none.",
      "seats": {
        "P1": {
          "battlefield": ["Shizo, Death's Storehouse", "Swamp", "Scenario Legend", "Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/gains fear/",
          "targets": ["Scenario Legend"]
        }
      ],
      "expect": [
        {
          "keywords": {
            "card": "Scenario Legend",
            "has": ["fear"]
          }
        },
        {
          "keywords": {
            "card": "Scenario Bear",
            "lacks": ["fear"]
          }
        },
        {
          "tapped": {
            "card": "Shizo, Death's Storehouse",
            "equals": true
          }
        }
      ]
    }
  ]
}
