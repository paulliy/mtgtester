          "player": "P1",
          "choose": "/^Cast Wizard's Lightning/",
          "targets": ["P2"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 37
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Wizard's Lightning"]
          }
        }
      ]
    },
    {
      "id": "wizards-lightning-full-cost-without-wizard",
      "title": "Wizard's Lightning: with no Wizard it costs the full {2}{R}",
      "clauses": [1],
