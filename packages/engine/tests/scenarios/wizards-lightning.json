      ],
      "expectedOutcome": "The spell still costs {2}{R}: it can't be cast with one land, stays in your hand, and P2 takes no damage.",
      "seats": {
        "P1": {
          "hand": ["Wizard's Lightning"],
          "battlefield": ["Mountain", "Scenario Bear"]
        },
        "P2": {}
      },
      "script": [],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
