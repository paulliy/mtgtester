      "instructions": [
        "Control Scenario Wizard with a single Mountain, cast Wizard's Lightning at P2 (it costs {R})."
      ],
      "expectedOutcome": "Wizard's Lightning is cast for {R} and deals 3 damage to P2 (37).",
