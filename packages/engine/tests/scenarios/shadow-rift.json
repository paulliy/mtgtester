      "id": "shadow-rift-shadow-attacker-unblockable",
      "title": "Shadow Rift: a creature with shadow can't be blocked by a creature without shadow",
      "clauses": [1],
      "instructions": [
        "Cast Shadow Rift targeting Scenario Bear, then attack P2 with it.",
        "P2 controls only Scenario Ogre (no shadow)."
      ],
      "expectedOutcome": "P2 is never asked to block; Scenario Bear deals 2 damage and Shadow Rift draws a card.",
      "seats": {
        "P1": {
          "hand": ["Shadow Rift"],
          "battlefield": ["Island", "Scenario Bear"],
          "libraryTop": ["Forest"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Shadow Rift/",
          "targets": ["Scenario Bear"]
        },
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Forest"]
          }
        },
        {
          "keywords": {
            "card": "Scenario Bear",
            "has": ["shadow"]
          }
        }
      ],
      "continue": {
        "throughCombat": true
      }
    },
    {
      "id": "shadow-rift-shadow-blocker-may-block",
      "title": "Shadow Rift: a creature with shadow may block it",
      "clauses": [1],
      "instructions": [
        "Cast Shadow Rift targeting Scenario Bear, then attack P2 with it.",
        "P2 blocks with Scenario Shade (shadow)."
      ],
      "expectedOutcome": "The block is legal: both 2/2 creatures die and P2 takes no damage.",
      "seats": {
        "P1": {
          "hand": ["Shadow Rift"],
          "battlefield": ["Island", "Scenario Bear"],
          "libraryTop": ["Forest"]
        },
        "P2": {
          "battlefield": ["Scenario Shade"]
        }
      },
      "script": [
        {
          "player": "P1",
