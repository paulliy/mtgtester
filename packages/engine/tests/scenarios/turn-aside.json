  "scenarios": [
    {
      "id": "turn-aside-counters-spell-targeting-your-permanent",
      "title": "Turn Aside: counters a spell that targets a permanent you control",
      "clauses": [1],
      "instructions": [
        "P2 casts Scenario Bolt at your Scenario Bear.",
        "Cast Turn Aside targeting Scenario Bolt."
      ],
      "expectedOutcome": "Scenario Bolt targets your Bear, so it can be countered: it goes to P2's graveyard without dealing damage, the Bear survives.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "hand": ["Turn Aside"],
          "battlefield": ["Island", "Island", "Scenario Bear"]
        },
        "P2": {
          "hand": ["Scenario Bolt"],
          "battlefield": ["Mountain"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "/^Cast Scenario Bolt/",
          "targets": ["Scenario Bear"]
        },
        {
          "player": "P1",
          "choose": "/^Cast Turn Aside/",
          "targets": ["Scenario Bolt"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Bolt"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Turn Aside"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "lacks": ["Scenario Elk"]
          }
        }
      ]
    },
    {
      "id": "turn-aside-spell-targeting-opponents-permanent-not-counterable",
      "title": "Turn Aside: a spell that targets only an opponent's permanent can't be targeted",
      "clauses": [1],
      "instructions": [
        "P2 casts Scenario Bolt at its own Scenario Wolf.",
        "Turn Aside is not offered, because the spell targets a permanent P2 controls, not you."
      ],
      "expectedOutcome": "Scenario Bolt resolves and kills P2's Wolf; Turn Aside stays in your hand.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "hand": ["Turn Aside"],
          "battlefield": ["Island", "Scenario Bear"]
        },
        "P2": {
          "hand": ["Scenario Bolt"],
          "battlefield": ["Mountain", "Scenario Wolf"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "/^Cast Scenario Bolt/",
          "targets": ["Scenario Wolf"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Wolf", "Scenario Bolt"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Turn Aside"]
          }
        }
      ]
    }
