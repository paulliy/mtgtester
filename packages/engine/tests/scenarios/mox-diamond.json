      "id": "mox-diamond-discard-land",
      "title": "Mox Diamond: discard a land as it enters, then tap it for red",
      "clauses": [1, 2],
      "instructions": [
        "Cast Mox Diamond.",
        "Discard Forest as it enters.",
        "Cast Scenario Imp, tapping Mox Diamond for {R}."
      ],
      "expectedOutcome": "Forest is discarded, Mox Diamond enters, and its red mana casts Scenario Imp.",
      "seats": {
        "P1": {
          "hand": ["Mox Diamond", "Forest", "Scenario Imp"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Mox Diamond/"
        },
        {
          "player": "P1",
          "choose": "Discard Forest"
        },
        {
          "player": "P1",
          "choose": "/^Cast Scenario Imp/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Mox Diamond", "Scenario Imp"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Forest"],
            "lacks": ["Mox Diamond"]
          }
