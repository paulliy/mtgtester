    }
  ],
  "scenarios": [
    {
      "id": "shadowmage-infiltrator-unblockable-by-nonblack",
      "title": "Shadowmage Infiltrator: a nonblack nonartifact creature can't block it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Shadowmage Infiltrator while P2 controls only Scenario Bear (green)."
      ],
      "expectedOutcome": "P2 is never asked to block; Shadowmage Infiltrator deals 1 damage to P2.",
      "seats": {
        "P1": {
          "battlefield": ["Shadowmage Infiltrator"]
        },
        "P2": {
          "battlefield": ["Scenario Bear"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P1",
          "choose": "No"
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 39
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "shadowmage-infiltrator-blockable-by-black",
      "title": "Shadowmage Infiltrator: a black creature may block it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Shadowmage Infiltrator.",
        "P2 blocks with Scenario Zombie (black)."
      ],
      "expectedOutcome": "The block is legal: Shadowmage Infiltrator is blocked by Scenario Zombie and P2 takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Shadowmage Infiltrator"]
        },
        "P2": {
          "battlefield": ["Scenario Zombie"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Shadowmage Infiltrator"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Zombie"]
          }
        }
      ]
    }
  ]
