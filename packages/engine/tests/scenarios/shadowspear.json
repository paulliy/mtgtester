      "id": "shadowspear-strips-hexproof",
      "title": "Shadowspear: opponents' permanents lose hexproof, so their creature can be targeted",
      "clauses": [2],
      "instructions": [
        "Activate Shadowspear's {1} ability.",
        "Cast Scenario Bolt on P2's Scenario Troll."
      ],
      "expectedOutcome": "Scenario Troll loses hexproof and dies to Scenario Bolt.",
      "seats": {
        "P1": {
          "hand": ["Scenario Bolt"],
          "battlefield": ["Shadowspear", "Mountain", "Mountain"]
        },
        "P2": {
          "battlefield": ["Scenario Troll"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/lose hexproof and indestructible/"
        },
        {
          "player": "P1",
          "choose": "Pass priority"
        },
        {
          "player": "P1",
          "choose": "/^Cast Scenario Bolt/",
          "targets": ["Scenario Troll"]
        }
      ],
      "expect": [
        {
          "zone": {
