  "scenarios": [
    {
      "id": "mask-of-riddles-unblockable",
      "title": "Mask of Riddles: a nonblack, nonartifact creature can't block the equipped creature",
      "clauses": [1],
      "instructions": [
        "Attack P2 with the equipped Scenario Bear while P2 controls only Scenario Ogre (red, nonartifact).",
        "Accept the draw trigger."
      ],
      "expectedOutcome": "P2 is never asked to block, takes 2 damage, and P1 draws a Forest.",
      "seats": {
        "P1": {
          "battlefield": [
            "Scenario Bear",
            {
              "card": "Mask of Riddles",
              "attachedTo": {
                "player": "P1",
                "card": "Scenario Bear"
              }
            }
          ],
          "libraryTop": ["Forest"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P1",
          "choose": "Yes"
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "has": ["Forest"]
          }
        }
      ]
    },
    {
      "id": "mask-of-riddles-blockable",
      "title": "Mask of Riddles: a black creature may block the equipped creature",
      "clauses": [1],
      "instructions": [
        "Attack P2 with the equipped Scenario Bear; P2 controls Scenario Ogre and the black Scenario Knight.",
        "Only the Knight may block; it blocks."
      ],
      "expectedOutcome": "The Knight blocks: no damage to P2 and so no draw; Scenario Bear (2/2) trades with the Knight.",
      "seats": {
        "P1": {
          "battlefield": [
            "Scenario Bear",
            {
              "card": "Mask of Riddles",
              "attachedTo": {
                "player": "P1",
                "card": "Scenario Bear"
              }
            }
          ],
          "libraryTop": ["Forest"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre", "Scenario Knight"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Bear"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Knight"]
          }
        }
      ]
