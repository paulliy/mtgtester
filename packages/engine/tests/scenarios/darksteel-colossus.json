{
  "schemaVersion": 1,
  "card": "Darksteel Colossus",
  "scenarios": [
    {
      "id": "darksteel-colossus-discard-shuffles",
      "title": "Darksteel Colossus: discarded, it is revealed and shuffled into the library instead",
      "clauses": [3],
      "instructions": ["Cast Thoughtseize targeting yourself and choose Darksteel Colossus."],
      "expectedOutcome": "Darksteel Colossus never reaches the graveyard: it is revealed and shuffled into your library.",
      "seats": {
        "P1": {
          "hand": ["Thoughtseize", "Darksteel Colossus", "Counterspell"],
          "battlefield": ["Swamp"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Thoughtseize/",
          "targets": ["P1"]
        },
        {
          "player": "P1",
          "choose": "/Darksteel Colossus/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "library",
            "has": ["Darksteel Colossus"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Thoughtseize"],
            "lacks": ["Darksteel Colossus"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "hand",
            "lacks": ["Darksteel Colossus"]
          }
        },
        {
          "event": {
            "type": "shuffle",
            "count": 1
          }
        },
        {
          "event": {
            "type": "revealCard"
          }
        }
      ]
    },
    {
      "id": "darksteel-colossus-rest-in-peace-exile",
      "title": "Darksteel Colossus: with Rest in Peace, its owner chooses exile",
      "clauses": [3],
      "instructions": [
        "With Rest in Peace on the battlefield, cast Thoughtseize targeting yourself and choose Darksteel Colossus.",
        "Choose to exile it."
      ],
      "expectedOutcome": "Both replacements apply; the owner picks Rest in Peace and Darksteel Colossus is exiled.",
      "seats": {
        "P1": {
          "hand": ["Thoughtseize", "Darksteel Colossus", "Counterspell"],
          "battlefield": ["Swamp", "Rest in Peace"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Cast Thoughtseize/",
          "targets": ["P1"]
        },
        {
          "player": "P1",
          "choose": "/Darksteel Colossus/"
        },
        {
          "player": "P1",
          "choose": "/^Exile Darksteel Colossus/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "exile",
            "has": ["Darksteel Colossus"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "library",
            "lacks": ["Darksteel Colossus"]
          }
        }
      ]
    }
  ]
}
