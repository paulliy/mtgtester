{
  "schemaVersion": 1,
  "card": "Steel Leaf Champion",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Ogre",
      "typeLine": "Creature — Ogre",
      "manaCost": "{2}{R}",
      "power": "3",
      "toughness": "3"
    }
  ],
  "scenarios": [
    {
      "id": "steel-leaf-champion-blocked-by-power-three",
      "title": "Steel Leaf Champion: a creature with power 3 may block it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Steel Leaf Champion.",
        "P2 blocks it with Scenario Ogre (power 3)."
      ],
      "expectedOutcome": "The block is legal: Scenario Ogre dies and P2 takes no damage.",
      "seats": {
        "P1": { "battlefield": ["Steel Leaf Champion"] },
        "P2": { "battlefield": ["Scenario Ogre"] }
      },
      "script": [
        { "player": "P1", "choose": "Declare attackers", "targets": ["P2"] },
        { "player": "P2", "choose": "Declare blockers", "targets": ["Steel Leaf Champion"] }
      ],
      "continue": { "throughCombat": true },
      "expect": [
        { "life": { "player": "P2", "equals": 40 } },
        { "zone": { "player": "P2", "zone": "graveyard", "has": ["Scenario Ogre"] } }
      ]
    },
    {
      "id": "steel-leaf-champion-unblockable-by-power-two",
      "title": "Steel Leaf Champion: a creature with power 2 or less can't block it",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Steel Leaf Champion while P2 controls only Scenario Bear (power 2)."
      ],
      "expectedOutcome": "P2 is never asked to block; Steel Leaf Champion deals 5 damage to P2.",
      "seats": {
        "P1": { "battlefield": ["Steel Leaf Champion"] },
        "P2": { "battlefield": ["Scenario Bear"] }
      },
      "script": [{ "player": "P1", "choose": "Declare attackers", "targets": ["P2"] }],
      "continue": { "throughCombat": true },
      "expect": [
        { "life": { "player": "P2", "equals": 35 } },
        { "zone": { "player": "P2", "zone": "battlefield", "has": ["Scenario Bear"] } }
      ]
    }
  ]
}
