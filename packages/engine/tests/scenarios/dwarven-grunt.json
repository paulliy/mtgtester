            "equals": 39
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Bear"]
          }
        }
      ]
    },
    {
      "id": "dwarven-grunt-blockable-without-mountain",
      "title": "Dwarven Grunt: may be blocked when the defender controls no Mountain",
      "clauses": [1],
      "instructions": [
