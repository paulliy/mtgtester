            "Forest",
            "Forest",
            "Forest",
            "Forest",
            "Forest",
            "Forest",
            "Forest",
            "Forest"
          ]
        },
        "P2": {
          "battlefield": ["Scenario Bear", "Scenario Wolf"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "Declare attackers",
