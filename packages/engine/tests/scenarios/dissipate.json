{
  "schemaVersion": 1,
  "card": "Dissipate",
  "supportCards": [
    {
      "name": "Scenario Bear",
      "typeLine": "Creature — Bear",
      "manaCost": "{1}{G}",
      "power": "2",
      "toughness": "2"
    },
    {
      "name": "Scenario Ward Bolt",
      "typeLine": "Instant",
      "manaCost": "{R}",
      "oracleText": "This spell can't be countered.\nScenario Ward Bolt deals 3 damage to any target."
    }
  ],
  "scenarios": [
    {
      "id": "dissipate-exiles-countered-spell",
      "title": "Dissipate: a countered creature spell is exiled, not put into the graveyard",
      "clauses": [1],
      "instructions": ["P2 casts Scenario Bear.", "Cast Dissipate targeting Scenario Bear."],
      "expectedOutcome": "Scenario Bear is countered and exiled instead of going to P2's graveyard; Dissipate goes to your graveyard.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "hand": ["Dissipate"],
          "battlefield": ["Island", "Island", "Island"]
        },
        "P2": {
          "hand": ["Scenario Bear"],
          "battlefield": ["Forest", "Forest"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "/^Cast Scenario Bear/"
        },
        {
          "player": "P1",
          "choose": "/^Cast Dissipate/",
          "targets": ["Scenario Bear"]
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P2",
            "zone": "exile",
            "has": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "lacks": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "lacks": ["Scenario Bear"]
          }
        },
        {
          "zone": {
            "player": "P1",
            "zone": "graveyard",
            "has": ["Dissipate"]
          }
        }
      ]
    },
    {
      "id": "dissipate-uncounterable-resolves",
      "title": "Dissipate: a spell that can't be countered is not countered, so it is not exiled",
      "clauses": [1],
      "instructions": ["P2 casts Scenario Ward Bolt at you.", "Cast Dissipate targeting it."],
      "expectedOutcome": "Scenario Ward Bolt can't be countered, so Dissipate does nothing to it: it resolves, deals 3 damage to you, and goes to P2's graveyard rather than exile.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "hand": ["Dissipate"],
          "battlefield": ["Island", "Island", "Island"]
        },
        "P2": {
          "hand": ["Scenario Ward Bolt"],
          "battlefield": ["Mountain"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "/^Cast Scenario Ward Bolt/",
          "targets": ["P1"]
        },
        {
          "player": "P1",
          "choose": "/^Cast Dissipate/",
          "targets": ["Scenario Ward Bolt"]
        }
      ],
      "expect": [
        {
          "life": {
            "player": "P1",
            "equals": 37
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "graveyard",
            "has": ["Scenario Ward Bolt"]
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "exile",
            "lacks": ["Scenario Ward Bolt"]
          }
        }
      ]
    }
  ]
