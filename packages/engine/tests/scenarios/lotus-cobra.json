{
  "schemaVersion": 1,
  "card": "Lotus Cobra",
  "supportCards": [
    {
      "name": "Scenario Squire",
      "typeLine": "Creature \u2014 Human",
      "manaCost": "{1}{W}",
      "power": "1",
      "toughness": "2"
    }
  ],
  "scenarios": [
    {
      "id": "lotus-cobra-landfall-mana",
      "title": "Lotus Cobra: a land entering adds one mana of any color",
      "clauses": [1],
      "instructions": [
        "Play Forest; Lotus Cobra's trigger adds one mana; choose white.",
        "Cast Scenario Squire with the white mana and the Forest."
      ],
      "expectedOutcome": "Scenario Squire is on the battlefield, paid with the Cobra's white mana and the Forest.",
      "seats": {
        "P1": {
          "hand": ["Forest", "Scenario Squire"],
          "battlefield": ["Lotus Cobra"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "/^Play Forest/"
        },
        {
          "player": "P1",
          "choose": "/W|White|white/"
        },
        {
          "player": "P1",
          "choose": "/^Cast Scenario Squire/"
        }
      ],
      "expect": [
        {
          "zone": {
            "player": "P1",
            "zone": "battlefield",
            "has": ["Scenario Squire"]
          }
        },
        {
          "event": {
            "type": "manaAdded",
            "payload": "Lotus Cobra"
          }
        }
      ]
    },
    {
      "id": "lotus-cobra-ignores-opponent-land",
      "title": "Lotus Cobra: a land entering under an opponent's control adds nothing",
      "clauses": [1],
      "instructions": ["P2 plays a Forest on their turn."],
      "expectedOutcome": "Lotus Cobra does not trigger; no mana is added from it.",
      "turn": {
        "player": "P2"
      },
      "seats": {
        "P1": {
          "battlefield": ["Lotus Cobra"]
        },
        "P2": {
          "hand": ["Forest"]
        }
      },
      "script": [
        {
          "player": "P2",
          "choose": "/^Play Forest/"
        }
      ],
      "expect": [
        {
          "event": {
            "type": "manaAdded",
            "payload": "Lotus Cobra",
            "count": 0
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Forest"]
          }
        }
      ]
    }
  ]
}
