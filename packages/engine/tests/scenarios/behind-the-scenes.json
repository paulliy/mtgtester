    },
    {
      "name": "Scenario Ogre",
      "typeLine": "Creature — Ogre",
      "manaCost": "{2}{R}",
      "power": "3",
      "toughness": "3"
    },
    {
      "name": "Scenario Wall",
      "typeLine": "Creature — Wall",
      "manaCost": "{2}",
