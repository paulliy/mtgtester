    }
  ],
  "scenarios": [
    {
      "id": "behind-the-scenes-greater-power-cant-block",
      "title": "Behind the Scenes: a creature with greater power can't block",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Bear (power 2) while P2 controls only Scenario Ogre (power 3)."
      ],
      "expectedOutcome": "P2 is never asked to block and takes 2 damage.",
      "seats": {
        "P1": {
          "battlefield": ["Behind the Scenes", "Scenario Bear"]
        },
        "P2": {
          "battlefield": ["Scenario Ogre"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 38
          }
        },
        {
          "zone": {
            "player": "P2",
            "zone": "battlefield",
            "has": ["Scenario Ogre"]
          }
        }
      ]
    },
    {
      "id": "behind-the-scenes-equal-power-may-block",
      "title": "Behind the Scenes: a creature with power no greater may block",
      "clauses": [1],
      "instructions": [
        "Attack P2 with Scenario Bear (power 2) while P2 controls Scenario Wall (power 0).",
        "P2 blocks."
      ],
      "expectedOutcome": "The block is legal: P2 takes no damage.",
      "seats": {
        "P1": {
          "battlefield": ["Behind the Scenes", "Scenario Bear"]
        },
        "P2": {
          "battlefield": ["Scenario Wall"]
        }
      },
      "script": [
        {
          "player": "P1",
          "choose": "Declare attackers",
          "targets": ["P2"]
        },
        {
          "player": "P2",
          "choose": "Declare blockers",
          "targets": ["Scenario Bear"]
        }
      ],
      "continue": {
        "throughCombat": true
      },
      "expect": [
        {
          "life": {
            "player": "P2",
            "equals": 40
          }
        },
        {
          "event": {
            "type": "block",
            "count": 1
          }
        }
      ]
    }
  ]
}
